---
import Base from '../layouts/Base.astro';
import CaseStudyLayout from '../components/work/CaseStudyLayout.astro';
import SystemsJoinDiagram from '../components/work/diagrams/SystemsJoinDiagram.astro';

// The toolkit ledger. `key` drives the live-receipts cross-highlighting:
// hovering a row lights every element on the page tagged with that key.
const toolkit = [
  {
    key: 'powerbi',
    tool: 'Power BI + Power Query',
    depth: 'Star-schema modeling, DAX measures, ingestion and transformation, interactive report design',
    receipts: [
      { text: 'The Noll Team intelligence system', href: '/work/noll-team' },
      { text: '3Rivers growth-dashboard architecture' },
      { text: 'NBA economic impact analysis' },
    ],
  },
  {
    key: 'python',
    tool: 'Python',
    depth: 'Data standardization, analytical modeling, machine learning coursework',
    receipts: [
      { text: 'Revenue-per-connection model', href: '/work/noll-team' },
      { text: 'Loan default prediction' },
    ],
  },
  {
    key: 'llm',
    tool: 'LLM pipelines',
    depth: 'Prompt engineering iterated against real output, batch processing, sentiment analysis',
    receipts: [
      { text: 'The Noll Team survey pipeline', href: '/work/noll-team' },
      { text: 'A-LIGN qualification agent', href: '/work/prospecting-automation' },
    ],
  },
  {
    key: 'sql',
    tool: 'SQL',
    depth: 'Normalized schema design, foreign keys, JOINs, aggregations, window functions',
    receipts: [{ text: 'FinEdu database, below' }],
  },
  {
    key: 'lowcode',
    tool: 'Low-code automation',
    depth: 'Power Automate flows, conditional logic, date expressions, null-check guards',
    receipts: [{ text: 'Florida DOH permit system', href: '/work/permit-modernization' }],
  },
  {
    key: 'sheets',
    tool: 'Sheets systems',
    depth: 'Formula-driven system design, linked tabs, automation built for handoff',
    receipts: [{ text: 'The Noll Team self-computing tracker', href: '/work/noll-team' }],
  },
  {
    key: 'r',
    tool: 'R',
    depth: 'Statistical programming, data manipulation, visualization',
    receipts: [{ text: 'ISM 4542 coursework' }],
  },
  {
    key: 'web',
    tool: 'Web',
    depth: 'Self-taught HTML and CSS, GitHub Pages deployment, DNS configuration',
    receipts: [{ text: 'This site' }],
  },
];

const projects = [
  {
    tools: 'python',
    label: 'ISM 6136 · GRADUATE DATA MINING, TAKEN AS AN UNDERGRADUATE',
    title: 'Loan default prediction',
    body: 'A full end-to-end predictive pipeline on loan data: preparation and exploratory analysis, kMeans clustering to segment borrowers, then a model comparison between a decision tree and a neural network, evaluated on reasoning beyond raw accuracy.',
    method: 'METHOD · EDA → KMEANS (OPTIMAL K=4, SILHOUETTE 0.514) → DECISION TREE VS. NEURAL NETWORK',
  },
  {
    tools: 'powerbi',
    label: 'ISM 4930 · DATA VISUALIZATION · SELF-SCOPED',
    title: 'NBA economic impact analysis',
    body: 'My most independently scoped project: I designed the research questions myself, testing team payroll against metro GDP growth, and win percentage against attendance and local hospitality employment. Joining sports data to federal economic data required a hand-built NBA-to-metro crosswalk, since no such mapping exists.',
    method: 'METHOD · 5 LINKED TABLES ACROSS 4 SOURCE DOMAINS (BASKETBALL-REFERENCE, BEA, BLS, CENSUS) · GEOFIPS CROSSWALK · ANIMATED CHOROPLETHS · INTERACTIVE TEAM SELECTOR',
  },
  {
    tools: 'sql',
    label: 'ISM 4212 · DATABASE DESIGN AND ADMINISTRATION · A+',
    title: 'FinEdu SQL database',
    body: 'A normalized relational database designed from scratch around FinEdu, my own financial-literacy concept: six tables with proper foreign-key relationships, then thirteen queries against it. Built on an idea I have carried since high school, so the schema models a business I actually think about.',
    method: 'METHOD · 6-TABLE NORMALIZED SCHEMA · 13 QUERIES SPANNING JOINS, AGGREGATIONS, AND WINDOW FUNCTIONS',
  },
];
---

<Base
  title="Technical — Michael Doerffler"
  description="The machinery behind the case studies: data engineering in a regulated financial institution, graduate-level machine learning, database design, and a toolkit where every tool cites where it was proven."
>
  <div class="blueprint-grid" aria-hidden="true"></div>

  <CaseStudyLayout
    caseLabel="TECHNICAL · THE MACHINERY"
    eyebrow="DATA ENGINEERING · ML · SQL · APPLIED AI"
    titleLine1="The machinery"
    titleLine2="behind the case studies."
    standfirst="The engagements show judgment and outcomes. This page shows what is underneath: data engineering inside a regulated financial institution, graduate-level machine learning, database design, and a toolkit where every tool cites the place it was proven."
    nextLabel="CASE STUDIES"
    nextHref="/#work"
  >
    <section class="case-section">
      <div class="plate" data-reveal>
        <span class="plate-id">PLATE 01</span>
        <div class="sec-label">FEATURED · 3RIVERS FEDERAL CREDIT UNION</div>
      </div>
      <div class="challenge-grid" data-reveal>
        <p class="body">
          3Rivers is a federally regulated credit union: real member data, enterprise systems, and
          compliance obligations, staffed by people who had been doing data, AI, and finance work
          for years. I spent a summer there as a Business Intelligence intern, working close to the
          data layer on protected systems.
        </p>
        <p class="body">
          It was also the room where I was the least experienced person present. I spent it asking
          questions, absorbing how experienced practitioners scope problems and handle data, and
          carrying what I learned directly into the internship I was running in parallel that same
          summer.
        </p>
      </div>

      <div class="proj" data-reveal data-tools="sql">
        <div class="proj-meta">
          <p class="proj-status">SHIPPED</p>
          <h3 class="proj-title">Mortgage Inquiry Intelligence Report</h3>
        </div>
        <div class="proj-main">
          <p class="proj-body">
            Loan officers had no way of knowing a member was actively shopping for a mortgage until
            it was often too late. The signal existed, scattered across systems that did not talk
            to each other. I joined SavvyMoney mortgage-alert data with member records and loan
            officer data across three enterprise systems, Alkami, Exasol, and network server files,
            and did the genuinely hard part: normalizing inconsistent field lengths and
            standardizing identifiers that did not match across schemas. The output is a warm-lead
            report that gives loan officers early visibility into members already in the market.
          </p>
        </div>
      </div>

      <div class="proj" data-reveal data-tools="powerbi">
        <div class="proj-meta">
          <p class="proj-status">ARCHITECTURE BUILT · DASHBOARD NOT DELIVERED</p>
          <h3 class="proj-title">Strategic Growth Intelligence Dashboard</h3>
        </div>
        <div class="proj-main">
          <p class="proj-body">
            A county-level expansion analysis across more than fifteen Indiana counties: demographic,
            geographic, and competitive data layered together, with branch-reach analysis at one,
            three, and five miles. I collected data from disparate sources, cleaned and standardized
            it, and built the Power Query relationship models tying the datasets together. The
            project's scope ran past the internship clock: I built and documented the data
            architecture and pipeline and handed off a foundation someone could continue from; the
            finished dashboard was not delivered before the internship ended.
          </p>
        </div>
      </div>

      <SystemsJoinDiagram />

      <div class="endorse" data-reveal>
        <p class="endorse-label">FROM MY MANAGER · VP OF DATA INTEGRITY</p>
        <p class="endorse-body">
          Chad's LinkedIn recommendation afterward highlighted how I operate rather than any single
          deliverable: that I assess new situations quickly and respond effectively, that I make
          sure I understand a project's scope before executing, and that I follow up after delivery
          to confirm the outcome was actually achieved.
        </p>
      </div>
    </section>

    <section class="case-section">
      <div class="plate" data-reveal>
        <span class="plate-id">PLATE 02</span>
        <div class="sec-label">THREE PROJECTS</div>
      </div>
      {projects.map((p) => (
        <div class="proj" data-reveal data-tools={p.tools}>
          <div class="proj-meta">
            <p class="proj-status">{p.label}</p>
            <h3 class="proj-title">{p.title}</h3>
          </div>
          <div class="proj-main">
            <p class="proj-body">{p.body}</p>
            <p class="proj-method">{p.method}</p>
          </div>
        </div>
      ))}
    </section>

    <section class="case-section">
      <div class="plate" data-reveal>
        <span class="plate-id">PLATE 03</span>
        <div class="sec-label">THE TOOLKIT, WITH RECEIPTS</div>
      </div>
      <p class="tk-note" data-reveal>
        Every tool cites the place it was proven. On a desktop, rest on a row and the matching work
        lights up.
      </p>
      <div class="tk" data-reveal>
        {toolkit.map((t) => (
          <div class="tk-row" data-key={t.key}>
            <div class="tk-tool">{t.tool}</div>
            <div class="tk-depth">{t.depth}</div>
            <div class="tk-receipts">
              {t.receipts.map((r, i) => (
                <>
                  {i > 0 && <span class="tk-sep">·</span>}
                  {r.href ? <a href={r.href}>{r.text}</a> : <span>{r.text}</span>}
                </>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="case-section" data-tools="web">
      <div class="plate" data-reveal>
        <span class="plate-id">PLATE 04</span>
        <div class="sec-label">AND THIS SITE</div>
      </div>
      <p class="kicker" data-reveal>
        The page you are reading is one of the builds: a self-taught front end, designed and
        deployed on GitHub Pages with a custom domain wired through DNS. Idea to live product, end
        to end.
      </p>
    </section>
  </CaseStudyLayout>
</Base>

<script>
  // Live receipts: hovering a toolkit row lights every element tagged with its
  // key, and hovering a tagged element lights its toolkit rows.
  function initReceipts() {
    const rows = document.querySelectorAll<HTMLElement>('.tk-row[data-key]');
    const targets = document.querySelectorAll<HTMLElement>('[data-tools]');
    if (!rows.length) return;
    const setLit = (key: string, on: boolean) => {
      targets.forEach((el) => {
        if ((el.dataset.tools || '').split(' ').includes(key)) el.classList.toggle('lit', on);
      });
      rows.forEach((r) => {
        if (r.dataset.key === key) r.classList.toggle('lit', on);
      });
    };
    rows.forEach((r) => {
      r.addEventListener('mouseenter', () => setLit(r.dataset.key!, true));
      r.addEventListener('mouseleave', () => setLit(r.dataset.key!, false));
    });
    targets.forEach((el) => {
      const keys = (el.dataset.tools || '').split(' ');
      el.addEventListener('mouseenter', () => keys.forEach((k) => setLit(k, true)));
      el.addEventListener('mouseleave', () => keys.forEach((k) => setLit(k, false)));
    });
  }
  document.addEventListener('astro:page-load', initReceipts);
</script>

<style>
  /* Blueprint sheet: faint drafting grid behind this page only */
  .blueprint-grid {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(41, 33, 23, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(41, 33, 23, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 88%, transparent 100%);
  }

  .case-section { margin-top: 12vh; }

  .plate { display: flex; align-items: baseline; gap: 18px; }
  .plate-id {
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent);
    border-bottom: 1px solid rgba(46, 74, 58, 0.4);
    padding-bottom: 3px;
  }

  .challenge-grid {
    margin-top: 3.5vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5vh 4vw;
  }
  .body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.65;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }

  /* Project rows: meta left, body right, full width */
  .proj {
    margin-top: 5vh;
    display: grid;
    grid-template-columns: minmax(240px, 400px) 1fr;
    gap: 2vh 4vw;
    padding-top: 4vh;
    border-top: 1px solid rgba(41, 33, 23, 0.14);
    transition: background 0.25s;
  }
  .proj-status {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  .proj-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 1.9vw, 27px);
    line-height: 1.25;
    color: var(--ink);
    text-wrap: pretty;
  }
  .proj-body {
    margin: 0;
    max-width: 72ch;
    font-family: var(--font-sans);
    font-size: clamp(14.5px, 1.15vw, 16px);
    line-height: 1.65;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }
  .proj-method {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.8;
    color: var(--grey-label);
  }

  /* Endorsement panel (compact green, like the DOH quote treatment) */
  .endorse {
    margin: 6vh 0 0;
    max-width: 1000px;
    padding: 4vh 3vw;
    background: rgba(46, 74, 58, 0.88);
    border-radius: 14px;
  }
  .endorse-label {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: rgba(233, 225, 207, 0.75);
  }
  .endorse-body {
    margin: 0;
    max-width: 820px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.55;
    color: var(--bone);
    text-wrap: pretty;
  }

  /* Toolkit ledger */
  .tk-note {
    margin: 3vh 0 0;
    font-family: var(--font-sans);
    font-size: clamp(13.5px, 1.1vw, 15px);
    line-height: 1.6;
    color: var(--ink-muted-4);
  }
  .tk {
    margin-top: 3.5vh;
    border-top: 1px solid rgba(41, 33, 23, 0.2);
  }
  .tk-row {
    display: grid;
    grid-template-columns: minmax(150px, 0.5fr) 1.1fr 1fr;
    gap: 0 3vw;
    padding: 2.6vh 0;
    border-bottom: 1px solid rgba(41, 33, 23, 0.12);
    transition: background 0.2s;
  }
  .tk-tool {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.3;
    color: var(--ink);
  }
  .tk-depth {
    font-family: var(--font-sans);
    font-size: clamp(13px, 1.05vw, 14.5px);
    line-height: 1.6;
    color: var(--ink-muted-3);
    text-wrap: pretty;
  }
  .tk-receipts {
    font-family: var(--font-sans);
    font-size: clamp(13px, 1.05vw, 14.5px);
    line-height: 1.6;
    color: var(--ink-muted-2);
  }
  .tk-receipts a {
    color: var(--accent);
    font-weight: 500;
  }
  .tk-receipts a:hover { border-bottom: 1px solid var(--accent); }
  .tk-sep { color: var(--grey-faint); margin: 0 7px; }

  /* Live receipts highlight */
  .tk-row.lit, .proj.lit { background: rgba(46, 74, 58, 0.07); }
  .proj.lit { border-top-color: rgba(46, 74, 58, 0.4); }

  /* Plotter stagger: rows print in sequence when the ledger reveals */
  @media (prefers-reduced-motion: no-preference) {
    .tk[data-reveal] .tk-row {
      opacity: 0;
      transform: translateY(7px);
      transition: opacity 0.4s ease, transform 0.4s var(--ease-mech);
    }
    .tk[data-reveal].is-visible .tk-row { opacity: 1; transform: none; }
    .tk[data-reveal].is-visible .tk-row:nth-child(1) { transition-delay: 0.05s; }
    .tk[data-reveal].is-visible .tk-row:nth-child(2) { transition-delay: 0.15s; }
    .tk[data-reveal].is-visible .tk-row:nth-child(3) { transition-delay: 0.25s; }
    .tk[data-reveal].is-visible .tk-row:nth-child(4) { transition-delay: 0.35s; }
    .tk[data-reveal].is-visible .tk-row:nth-child(5) { transition-delay: 0.45s; }
    .tk[data-reveal].is-visible .tk-row:nth-child(6) { transition-delay: 0.55s; }
    .tk[data-reveal].is-visible .tk-row:nth-child(7) { transition-delay: 0.65s; }
    .tk[data-reveal].is-visible .tk-row:nth-child(8) { transition-delay: 0.75s; }
  }

  .kicker {
    margin: 4vh 0 0;
    max-width: 900px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.4;
    color: var(--ink);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .challenge-grid { grid-template-columns: 1fr; }
    .proj { grid-template-columns: 1fr; gap: 1.5vh 0; }
    .tk-row { grid-template-columns: 1fr; gap: 8px 0; padding: 2.2vh 0; }
    .tk-note { display: none; }
  }
  @media (max-width: 720px) {
    .case-section { margin-top: 9vh; }
    .endorse { padding: 3vh 20px; }
  }
</style>
