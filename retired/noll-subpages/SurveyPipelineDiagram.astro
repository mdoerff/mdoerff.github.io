---
// FIG. 1 — The survey pipeline: six years of client feedback, read.
// A backlog of individual PDFs runs through an LLM prompt pipeline into
// sentiment and per-agent findings, documented in SOPs so it keeps running.
import DiagramDefs from './DiagramDefs.astro';
---

<figure class="fig" data-reveal>
  <figcaption class="fig-label">
    <span class="fig-accent">FIG. 1</span>&nbsp;&nbsp;THE SURVEY PIPELINE · BACKLOG TO PER-AGENT INSIGHT
  </figcaption>
  <div class="fig-scroll">
    <svg
      viewBox="0 0 1600 640"
      role="img"
      aria-label="Pipeline diagram: 400 client survey PDFs from 2019 to 2025 run through a batch LLM prompt pipeline with sentiment analysis, fanning out into per-agent findings across nine agents, documented in SOPs so it runs without the builder, and adopted into agent coaching."
      style="font-family: var(--font-sans); width: 100%; height: auto; display: block;"
    >
      <DiagramDefs prefix="sp" />

      <use href="#sp-reg" x="22" y="22" width="18" height="18" />
      <use href="#sp-reg" x="1560" y="22" width="18" height="18" />
      <use href="#sp-reg" x="22" y="600" width="18" height="18" />
      <use href="#sp-reg" x="1560" y="600" width="18" height="18" />

      <!-- ============ 1 · THE BACKLOG ============ -->
      <g transform="rotate(-0.3 175 320)">
        <text x="60" y="150" font-size="12" font-weight="700" letter-spacing="2" fill="var(--ink)">01 · THE BACKLOG</text>
        <text x="60" y="170" font-size="9.5" letter-spacing="1.4" fill="var(--grey-label)">NEVER READ AS A WHOLE</text>

        <!-- a stack of offset PDFs -->
        <g>
          <rect x="88" y="252" width="150" height="180" fill="var(--bone)" stroke="var(--ink-muted-4)" stroke-width="0.9" transform="rotate(-4 163 342)" />
          <rect x="76" y="262" width="150" height="180" fill="var(--bone)" stroke="var(--ink-muted-4)" stroke-width="0.9" transform="rotate(2 151 352)" />
          <rect x="64" y="272" width="150" height="180" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.2" />
          <rect x="64" y="272" width="150" height="180" fill="url(#sp-ht)" opacity="0.35" />
          <g stroke="var(--ink-muted-4)" stroke-width="0.7">
            <line x1="82" y1="306" x2="196" y2="306" /><line x1="82" y1="326" x2="196" y2="326" />
            <line x1="82" y1="346" x2="196" y2="346" /><line x1="82" y1="366" x2="176" y2="366" />
          </g>
        </g>
        <text x="139" y="474" font-size="12" font-weight="700" text-anchor="middle" fill="var(--ink)">400 SURVEYS</text>
        <text x="139" y="492" font-size="9" letter-spacing="1" text-anchor="middle" fill="var(--grey-label)">2019 TO 2025 · PDFS</text>
      </g>

      <!-- arrow -->
      <path d="M262 350 h66 m0 0 l-9 -5 m9 5 l-9 5" fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />

      <!-- ============ 2 · BATCH LLM ============ -->
      <g transform="rotate(0.3 470 330)">
        <text x="360" y="150" font-size="12" font-weight="700" letter-spacing="2" fill="var(--ink)">02 · BATCH LLM</text>
        <text x="360" y="170" font-size="9.5" letter-spacing="1.4" fill="var(--grey-label)">PROMPT PIPELINE</text>

        <rect x="360" y="300" width="184" height="100" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" transform="translate(3 -3)" />
        <rect x="360" y="300" width="184" height="100" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.4" />
        <text x="452" y="336" font-size="11" font-weight="700" text-anchor="middle" fill="var(--ink)">LLM PIPELINE</text>
        <text x="452" y="356" font-size="8.5" letter-spacing="0.8" text-anchor="middle" fill="var(--ink-muted-3)">BATCH · ITERATED PROMPTS</text>
        <text x="452" y="374" font-size="8.5" letter-spacing="0.8" text-anchor="middle" fill="var(--accent)">SENTIMENT ANALYSIS</text>
      </g>

      <!-- arrow -->
      <path d="M566 350 h60 m0 0 l-9 -5 m9 5 l-9 5" fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />

      <!-- ============ 3 · PER-AGENT FINDINGS ============ -->
      <g>
        <text x="700" y="150" font-size="12" font-weight="700" letter-spacing="2" fill="var(--ink)">03 · PER-AGENT FINDINGS</text>
        <text x="700" y="170" font-size="9.5" letter-spacing="1.4" fill="var(--grey-label)">BROKEN DOWN, AGENT BY AGENT · 9 AGENTS</text>

        <!-- fan-out lines to 9 rows -->
        <g stroke="var(--ink-muted-4)" stroke-width="0.7" fill="none" opacity="0.8">
          <path d="M628 350 Q 690 214 748 214" /><path d="M628 350 Q 690 246 748 246" />
          <path d="M628 350 Q 690 278 748 278" /><path d="M628 350 Q 690 310 748 310" />
          <path d="M628 350 L 748 342" /><path d="M628 350 Q 690 374 748 374" />
          <path d="M628 350 Q 690 406 748 406" /><path d="M628 350 Q 690 438 748 438" />
          <path d="M628 350 Q 690 470 748 470" />
        </g>
        <!-- 9 agent rows: label bar + sentiment mark -->
        <g>
          {[202, 234, 266, 298, 330, 362, 394, 426, 458].map((y, i) => (
            <g>
              <rect x="748" y={y} width="150" height="22" fill="var(--bone)" stroke="var(--ink-muted-4)" stroke-width="0.8" />
              <text x="758" y={y + 15} font-size="8.5" letter-spacing="0.6" fill="var(--ink-muted-2)">{`AGENT ${String(i + 1).padStart(2, '0')}`}</text>
              <rect x="906" y={y + 5} width={[34, 20, 30, 12, 26, 22, 16, 28, 24][i]} height="12" fill="url(#sp-ht)" stroke="var(--accent)" stroke-width="0.7" />
            </g>
          ))}
        </g>
      </g>

      <!-- converge arrow -->
      <path d="M984 350 h70 m0 0 l-9 -5 m9 5 l-9 5" fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />

      <!-- ============ 4 · IT RUNS, AND IT'S USED ============ -->
      <g transform="rotate(0.3 1300 330)">
        <text x="1076" y="150" font-size="12" font-weight="700" letter-spacing="2" fill="var(--accent)">04 · IT RUNS, AND IT'S USED</text>
        <text x="1076" y="170" font-size="9.5" letter-spacing="1.4" fill="var(--grey-label)">DOCUMENTED · ADOPTED</text>

        <rect x="1076" y="262" width="230" height="66" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.2" />
        <text x="1191" y="290" font-size="10.5" font-weight="700" text-anchor="middle" fill="var(--ink)">SOP</text>
        <text x="1191" y="309" font-size="8.5" letter-spacing="0.8" text-anchor="middle" fill="var(--ink-muted-3)">RUNS WITHOUT ME</text>

        <path d="M1191 328 v22 m0 0 l-5 -9 m5 9 l5 -9" fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />

        <rect x="1073" y="372" width="236" height="72" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" transform="translate(3 -3)" />
        <rect x="1073" y="372" width="236" height="72" fill="var(--bone)" stroke="var(--accent)" stroke-width="1.6" />
        <text x="1191" y="400" font-size="10.5" font-weight="700" text-anchor="middle" fill="var(--ink)">ADOPTED INTO COACHING</text>
        <text x="1191" y="420" font-size="8.5" letter-spacing="0.8" text-anchor="middle" fill="var(--accent)">FEATURED ON THE PODCAST</text>
      </g>

      <text x="60" y="580" font-size="11" letter-spacing="1.4" fill="var(--ink-muted-4)">A DORMANT ASSET · SIX YEARS OF FEEDBACK · TURNED INTO PER-AGENT INSIGHT LEADERSHIP USES</text>
    </svg>
  </div>
</figure>

<style>
  .fig { margin: 12vh 0 0; }
  .fig-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--grey-label);
    margin-bottom: 4vh;
  }
  .fig-accent { color: var(--accent); font-weight: 500; }
  .fig-scroll { overflow-x: auto; }
  @media (max-width: 720px) {
    .fig-scroll svg { min-width: 1100px; }
  }
</style>
