---
import Base from '../../../layouts/Base.astro';
import CaseStudyLayout from '../../../components/work/CaseStudyLayout.astro';
import CaseColophon from '../../../components/work/CaseColophon.astro';
import CaseApproach from '../../../components/work/CaseApproach.astro';
import IntelligenceSystemDiagram from '../../../components/work/diagrams/IntelligenceSystemDiagram.astro';

const colophon = [
  { label: 'CLIENT', value: 'The Noll Team · Fort Wayne, IN' },
  { label: 'PART OF', value: 'The Noll Team internship' },
  { label: 'ROLE', value: 'Business intelligence · self-initiated' },
  { label: 'TIMELINE', value: '2025' },
  { label: 'STACK', value: 'Google Sheets · Power Query · Power BI · DAX · Python' },
  { label: 'STATUS', value: "Built and adopted · still the team's source of truth", accent: true },
];

const workstreams = [
  {
    title: 'Put a number on the premise',
    body: "The brokerage's whole model was that relationships drive revenue, but no one had ever tested it. I built a Python model that measured revenue per connection across all nine agents, turning the firm's core belief into a metric leadership could manage against.",
  },
  {
    title: 'Make the data compute itself',
    body: 'The office manager kept the weekly market and activity tracking by hand. Rather than take on the manual work, I re-engineered the Google Sheet into a self-computing system with linked tabs and automated calculation logic, built so it could be handed back and keep running. It removed more than an hour of manual work a week and later became the dashboard’s source.',
  },
  {
    title: 'Shape it into a model',
    body: 'I used Power Query to ingest and transform that data, then built a star-schema model with table relationships and DAX measures, so totals could be sliced any way the team needed without rebuilding anything by hand.',
  },
  {
    title: 'Make it self-serve',
    body: 'On top of the model I designed an interactive dashboard: a KPI header, a monthly trend chart, and a per-agent revenue-per-connection view, filterable to any individual agent or sub-team through a slicer panel and a metric selector. Leadership could interrogate it themselves instead of asking someone to assemble an answer.',
  },
];

const impact = [
  {
    label: 'THE FEED',
    body: 'More than an hour of weekly hand-tracking now computes itself, and the system was built to be handed back, so it kept running after the internship ended.',
  },
  {
    label: 'THE VIEW',
    body: "One live dashboard, filterable to any agent or sub-team, adopted as the team's at-a-glance source of truth. It stays current on its own because the automation underneath it feeds it every week.",
  },
  {
    label: 'THE PREMISE',
    body: 'Relationships drive revenue went from the firm’s founding belief to a measured number, revenue per connection, that leadership can watch move and manage against.',
  },
];
---

<Base
  title="A live view of the business — The Noll Team | Michael Doerffler"
  description="Case study: automating a real estate brokerage's weekly data feed and building a Power BI intelligence system on top of it, giving leadership a live, self-serve view of the whole business."
>
  <CaseStudyLayout
    caseLabel="THE NOLL TEAM · A LIVE VIEW OF THE BUSINESS"
    eyebrow="REAL ESTATE · BUSINESS INTELLIGENCE"
    titleLine1="One place the business"
    titleLine2="could see itself."
    standfirst="After months inside the team's numbers, one gap kept showing: there was no live, self-updating view of the business. Anyone who wanted the current picture waited for someone to assemble it by hand. I automated the weekly data feed first, then built a Power BI system on top of it. Leadership asked for a way to see where things stood. What I delivered was that, plus the automation underneath that keeps it current on its own."
    nextLabel="SIX YEARS OF CLIENT FEEDBACK"
    nextNote=""
  >
    <CaseColophon items={colophon} />

    <section class="case-section">
      <div class="sec-label" data-reveal>THE CHALLENGE</div>
      <div class="challenge-grid" data-reveal>
        <p class="body">
          The office manager tracked market and activity numbers by hand every week, and agent
          performance lived in scattered files. Nine agents, one shared business, and no one place
          where its numbers came together.
        </p>
        <p class="body">
          That meant every question about where the business stood started with someone building
          the answer: pulling files, reconciling copies, assembling a picture that was stale by the
          time it was finished.
        </p>
      </div>
      <p class="situation-stmt" data-reveal>
        There was <span class="situation-key">no single, live view</span> a busy broker-owner could
        open and trust.
      </p>
    </section>

    <section class="case-section">
      <div class="sec-label" data-reveal>THE APPROACH</div>
      <CaseApproach workstreams={workstreams} />
    </section>

    <IntelligenceSystemDiagram />

    <section class="case-section">
      <div class="sec-label" data-reveal>THE DASHBOARD</div>
      <figure class="dash" data-reveal>
        <figcaption class="dash-cap">
          SCHEMATIC OF THE LIVE REPORT · LAYOUT FAITHFUL · FIGURES AND AGENT NAMES NOT SHOWN
        </figcaption>
        <div class="dash-frame" role="img" aria-label="Schematic of the Power BI dashboard: a KPI header of four tiles, a monthly trend chart, a per-agent revenue-per-connection bubble view, and a right-hand panel with agent slicers and a metric selector. Figures and agent names are intentionally not shown.">
          <div class="dash-main">
            <div class="dash-kpis">
              {['TOTAL VOLUME', 'SALES', 'CONNECTIONS', 'REV / CONNECTION'].map((k) => (
                <div class="kpi-tile">
                  <span class="kpi-label">{k}</span>
                  <span class="kpi-bar"></span>
                </div>
              ))}
            </div>
            <div class="dash-charts">
              <div class="dash-chart">
                <span class="chart-label">MONTHLY TREND</span>
                <svg viewBox="0 0 320 120" aria-hidden="true" style="width: 100%; height: auto; display: block;">
                  <g stroke="rgba(41,33,23,0.1)" stroke-width="1">
                    <line x1="0" y1="30" x2="320" y2="30" /><line x1="0" y1="60" x2="320" y2="60" /><line x1="0" y1="90" x2="320" y2="90" />
                  </g>
                  <polyline points="8,92 42,78 76,84 110,62 144,70 178,48 212,56 246,38 280,46 312,28" fill="none" stroke="var(--accent)" stroke-width="2" />
                  <g fill="var(--accent)">
                    <circle cx="8" cy="92" r="2.5" /><circle cx="76" cy="84" r="2.5" /><circle cx="144" cy="70" r="2.5" /><circle cx="212" cy="56" r="2.5" /><circle cx="280" cy="46" r="2.5" />
                  </g>
                </svg>
              </div>
              <div class="dash-chart">
                <span class="chart-label">REVENUE PER CONNECTION · BY AGENT</span>
                <svg viewBox="0 0 320 120" aria-hidden="true" style="width: 100%; height: auto; display: block;">
                  <line x1="0" y1="104" x2="320" y2="104" stroke="rgba(41,33,23,0.18)" stroke-width="1" />
                  <g fill="rgba(46,74,58,0.28)" stroke="var(--accent)" stroke-width="1">
                    <circle cx="30" cy="80" r="9" /><circle cx="65" cy="62" r="13" /><circle cx="100" cy="88" r="6" />
                    <circle cx="135" cy="50" r="16" /><circle cx="172" cy="72" r="10" /><circle cx="207" cy="40" r="19" />
                    <circle cx="243" cy="66" r="12" /><circle cx="277" cy="84" r="7" /><circle cx="303" cy="58" r="10" />
                  </g>
                </svg>
              </div>
            </div>
          </div>
          <aside class="dash-side">
            <span class="side-label">AGENTS</span>
            <div class="side-rows">
              {Array.from({ length: 9 }).map(() => <span class="side-row"></span>)}
            </div>
            <span class="side-label side-label-2">METRIC</span>
            <div class="side-pills">
              <span class="side-pill side-pill-on">VOLUME</span>
              <span class="side-pill">SALES</span>
              <span class="side-pill">REV / CONN</span>
            </div>
          </aside>
        </div>
      </figure>
    </section>

    <section class="case-section">
      <div class="sec-label" data-reveal>THE IMPACT</div>
      <p class="impact-thesis" data-reveal>
        Questions that used to require assembly
        <span class="thesis-key">now have standing answers.</span>
      </p>
      <div class="impact-band" data-reveal>
        {impact.map((col) => (
          <div class="impact-col">
            <p class="impact-label">{col.label}</p>
            <p class="impact-body">{col.body}</p>
          </div>
        ))}
      </div>
      <p class="scope-line" data-reveal>
        SCOPE OF THE SYSTEM · $63.7M IN VOLUME · 189 SALES · 9 AGENTS · 8,523 CLIENT CONNECTIONS
      </p>
      <p class="impact-disclaimer" data-reveal>
        FIGURES ARE THE BUSINESS'S OWN VOLUMES AND THE SCOPE OF THE SYSTEM BUILT, NOT INDEPENDENTLY
        MEASURED OUTCOMES.
      </p>
    </section>

    <section class="case-section">
      <div class="sec-label" data-reveal>WHAT I'D DO DIFFERENTLY</div>
      <div class="diff-grid" data-reveal>
        <p class="diff-lead">Plumbing first, analysis second.</p>
        <p class="diff-body">
          I built the dashboard once I was already deep in the data, which was the right moment to
          see the gap but a late one to start the plumbing. Next time I set up the automated feed in
          the first week, not the fifth month, so every analysis after it inherits a clean source
          instead of me standardizing the same data twice.
        </p>
      </div>
    </section>

    <nav class="case-jump" data-reveal aria-label="More from this engagement">
      <a href="/work/noll-team">&larr;&nbsp; Part of THE NOLL TEAM</a>
      <a href="/work/noll-team/survey-pipeline">Next · Six years of client feedback&nbsp; &rarr;</a>
    </nav>
  </CaseStudyLayout>
</Base>

<style>
  .case-section { margin-top: 12vh; }

  .challenge-grid {
    margin-top: 3.5vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5vh 4vw;
  }
  .challenge-grid .body { max-width: none; margin-top: 0; }
  .body {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.65;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }

  .situation-stmt {
    margin: 5vh 0 0;
    max-width: 900px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.4;
    color: var(--ink);
    text-wrap: pretty;
  }
  .situation-key { color: var(--accent); border-bottom: 2px solid var(--accent); }

  /* Dashboard schematic */
  .dash { margin: 5vh 0 0; }
  .dash-cap {
    margin-bottom: 3vh;
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--grey-label);
  }
  .dash-frame {
    display: grid;
    grid-template-columns: 1fr 190px;
    gap: 0;
    border: 1px solid rgba(41, 33, 23, 0.24);
    background: var(--bone);
  }
  .dash-main { padding: 2.5vh 1.5vw; }
  .dash-kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 2.5vh;
  }
  .kpi-tile {
    border: 1px solid rgba(41, 33, 23, 0.14);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .kpi-label {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--grey-label);
  }
  .kpi-bar {
    display: block;
    width: 64%;
    height: 12px;
    background: rgba(41, 33, 23, 0.14);
  }
  .dash-charts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .dash-chart {
    border: 1px solid rgba(41, 33, 23, 0.14);
    padding: 12px 14px 8px;
  }
  .chart-label {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--grey-label);
  }
  .dash-side {
    border-left: 1px solid rgba(41, 33, 23, 0.14);
    padding: 2.5vh 16px;
    display: flex;
    flex-direction: column;
  }
  .side-label {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--grey-label);
    margin-bottom: 10px;
  }
  .side-label-2 { margin-top: 22px; }
  .side-rows { display: flex; flex-direction: column; gap: 8px; }
  .side-row {
    display: block;
    height: 10px;
    background: rgba(41, 33, 23, 0.12);
  }
  .side-rows .side-row:nth-child(odd) { width: 72%; }
  .side-rows .side-row:nth-child(even) { width: 58%; }
  .side-pills { display: flex; flex-direction: column; gap: 6px; }
  .side-pill {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-muted-3);
    border: 1px solid rgba(41, 33, 23, 0.18);
    padding: 5px 10px;
    width: fit-content;
  }
  .side-pill-on {
    color: var(--bone);
    background: var(--accent);
    border-color: var(--accent);
  }

  /* Impact */
  .impact-thesis {
    margin: 5vh 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(24px, 2.8vw, 42px);
    line-height: 1.3;
    color: var(--ink);
    text-wrap: pretty;
  }
  .thesis-key { color: var(--accent); }
  .impact-band {
    margin: 5vh 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 3vw;
    padding-top: 4vh;
    border-top: 1px solid rgba(41, 33, 23, 0.2);
  }
  .impact-label {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  .impact-body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(13.5px, 1.1vw, 15px);
    line-height: 1.6;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }
  .scope-line {
    margin: 5vh 0 0;
    padding-top: 2.5vh;
    border-top: 1px solid rgba(41, 33, 23, 0.14);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink-muted-4);
  }
  .impact-disclaimer {
    margin: 2vh 0 0;
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    line-height: 1.7;
    color: var(--grey-label);
  }

  /* What I'd do differently */
  .diff-grid {
    margin-top: 5vh;
    display: grid;
    grid-template-columns: minmax(220px, 380px) 1fr;
    gap: 2.5vh 4vw;
  }
  .diff-lead {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 2vw, 30px);
    line-height: 1.3;
    color: var(--ink);
    text-wrap: pretty;
  }
  .diff-body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.65;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }

  .case-jump {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 12vh;
    padding-top: 4vh;
    border-top: 1px solid rgba(41, 33, 23, 0.12);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .case-jump a { color: var(--ink-muted-3); transition: color 0.15s; }
  .case-jump a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .challenge-grid { grid-template-columns: 1fr; }
    .impact-band { grid-template-columns: 1fr; gap: 3.5vh 0; }
    .diff-grid { grid-template-columns: 1fr; gap: 2vh 0; }
    .dash-frame { grid-template-columns: 1fr; }
    .dash-side {
      border-left: none;
      border-top: 1px solid rgba(41, 33, 23, 0.14);
    }
    .dash-charts { grid-template-columns: 1fr; }
    .dash-kpis { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 720px) {
    .case-section { margin-top: 9vh; }
    .case-jump { flex-direction: column; gap: 14px; }
  }
</style>
