---
import Base from '../../../layouts/Base.astro';
import CaseStudyLayout from '../../../components/work/CaseStudyLayout.astro';
import CaseColophon from '../../../components/work/CaseColophon.astro';
import CaseSteps from '../../../components/work/CaseSteps.astro';
import CaseStats from '../../../components/work/CaseStats.astro';
import DecisionsDiagram from '../../../components/work/diagrams/DecisionsDiagram.astro';

const colophon = [
  { label: 'CLIENT', value: 'The Noll Team · Fort Wayne, IN' },
  { label: 'PART OF', value: 'The Noll Team internship' },
  { label: 'ROLE', value: 'Analytics · decision support' },
  { label: 'TIMELINE', value: '2025' },
  { label: 'STACK', value: 'Python · Excel · historical transaction data · benchmarking' },
  { label: 'STATUS', value: 'Delivered · each fed a decision leadership made', accent: true },
];

const steps = [
  {
    phase: 'DOES THE MODEL PAY?',
    title: 'Test the premise',
    body: "The brokerage's premise was that relationships drive revenue, but it had never been tested. I standardized multi-year lead and revenue data across all nine agents and modeled revenue per connection in Python, turning the premise into a metric the CEO used in agent development.",
    artifact: 'REVENUE PER CONNECTION · 9 AGENTS · A COACHING METRIC',
  },
  {
    phase: 'IS LUXURY WORTH A DIVISION?',
    title: 'Size the segment',
    body: "The CEO wanted to know whether a dedicated luxury division made sense. I segmented 20 years of historical transaction data against the local luxury benchmark, at a $500K threshold, and found a small share of sales driving a disproportionate share of revenue: 11% of sales generating 31% of the firm's total. That finding fed the launch of Noll Reserve, with a $6.75M flagship listing.",
    artifact: '20 YEARS OF DATA · 11% OF SALES → 31% OF REVENUE → NOLL RESERVE',
  },
  {
    phase: 'DOES STAGING PAY OFF?',
    title: 'Run the comparison',
    body: 'For the staging arm I ran a tighter study: a controlled comparison of 12 closings across three zip codes. Staged homes sold in 9 days versus 38, at 100.8% of list versus 97.9%. The division adopted the result as its actual sales pitch.',
    artifact: '12 CLOSINGS · 9 VS 38 DAYS · ADOPTED AS THE PITCH',
  },
];

const stats = [
  { value: '11% → 31%', label: 'LUXURY CONCENTRATION FOUND, FED NOLL RESERVE' },
  { value: '9 vs 38', label: 'DAYS ON MARKET, STAGED VS NOT, BECAME NTI’S PITCH' },
  { value: '3', label: 'QUESTIONS, THREE DECISIONS' },
];
---

<Base
  title="Questions leadership could act on — The Noll Team | Michael Doerffler"
  description="Case study: turning three open questions from a real estate CEO into analyses that drove real decisions, from a revenue model to the launch of a luxury division to a staging sales pitch."
>
  <CaseStudyLayout
    caseLabel="THE NOLL TEAM · QUESTIONS LEADERSHIP COULD ACT ON"
    eyebrow="REAL ESTATE · DECISION ANALYTICS"
    titleLine1="Questions,"
    titleLine2="turned into decisions."
    standfirst="A relationship-run brokerage makes a lot of calls on instinct. The CEO had good questions about the business he could not answer with the data as it sat. I turned three of them into analyses the team used to make real decisions: whether the relationship model actually paid, whether a luxury division made sense, and whether staging was worth it."
    nextLabel="THE NOLL TEAM"
    nextNote=""
  >
    <CaseColophon items={colophon} />

    <section class="case-section">
      <div class="sec-label" data-reveal>THE SITUATION</div>
      <p class="situation-stmt" data-reveal>
        The firm ran on relationships and experience, which worked, but it meant real strategic
        questions got answered by instinct. Three of them were
        <span class="situation-key">worth putting numbers to</span>.
      </p>
    </section>

    <section class="case-section">
      <div class="sec-label" data-reveal>THREE QUESTIONS · QUESTION, ANALYSIS, DECISION</div>
      <CaseSteps steps={steps} />
    </section>

    <DecisionsDiagram />

    <section class="case-section">
      <div class="sec-label" data-reveal>THE RESULT</div>
      <CaseStats
        stats={stats}
        note="Each analysis was small on its own. Together they show the pattern: a question the CEO had, a number that answered it, and a decision the team actually made off the result."
        disclaimer="FIGURES ARE FROM THE FIRM'S OWN HISTORICAL DATA AND THE STUDIES BUILT, NOT INDEPENDENTLY AUDITED."
      />
    </section>

    <section class="case-section">
      <div class="sec-label" data-reveal>WHAT I'D DO DIFFERENTLY</div>
      <p class="diff-body" data-reveal>
        These analyses were persuasive because each had a clear baseline. The staging study was only
        twelve closings, enough to make the call but thin to build a standing pitch on. Next time I
        set the sample size the decision needs up front, so the number is durable, not just
        directional.
      </p>
    </section>

    <nav class="case-jump" data-reveal aria-label="More from this engagement">
      <a href="/work/noll-team/survey-pipeline">&larr;&nbsp; Prev · Six years of client feedback</a>
      <a href="/work/noll-team">Back to THE NOLL TEAM&nbsp; &uarr;</a>
    </nav>
  </CaseStudyLayout>
</Base>

<style>
  .case-section { margin-top: 12vh; }

  .situation-stmt {
    margin: 5vh 0 0;
    max-width: 1050px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 36px);
    line-height: 1.35;
    color: var(--ink);
    text-wrap: pretty;
  }
  .situation-key { color: var(--accent); border-bottom: 2px solid var(--accent); }

  .diff-body {
    margin: 5vh 0 0;
    max-width: 700px;
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.65;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }

  .case-jump {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 12vh;
    padding-top: 4vh;
    border-top: 1px solid rgba(41, 33, 23, 0.12);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .case-jump a { color: var(--ink-muted-3); transition: color 0.15s; }
  .case-jump a:hover { color: var(--accent); }

  @media (max-width: 720px) {
    .case-section { margin-top: 9vh; }
    .case-jump { flex-direction: column; gap: 14px; }
  }
</style>
