---
// FIG. 1 — The intelligence system, source to report.
// Four labeled layers left to right: the self-computing tracking Sheet feeds
// Power Query, which loads a star-schema model with DAX measures, which drives
// one interactive report. Every label is a real fact from the engagement.
import DiagramDefs from './DiagramDefs.astro';
---

<figure class="fig" data-reveal>
  <figcaption class="fig-label">
    <span class="fig-accent">FIG. 1</span>&nbsp;&nbsp;THE INTELLIGENCE SYSTEM · SOURCE TO REPORT
  </figcaption>
  <div class="fig-scroll">
    <svg
      viewBox="0 0 1600 640"
      role="img"
      aria-label="Data pipeline diagram: a self-computing tracking sheet feeds Power Query, which loads a star-schema model with DAX measures joining a sales fact table to agent, sub-team and month dimensions, which drives one interactive report with a KPI header, trend chart, revenue-per-connection bubble plot, and a slicer and metric selector."
      style="font-family: var(--font-sans); width: 100%; height: auto; display: block;"
    >
      <DiagramDefs prefix="is" />

      <use href="#is-reg" x="22" y="22" width="18" height="18" />
      <use href="#is-reg" x="1560" y="22" width="18" height="18" />
      <use href="#is-reg" x="22" y="600" width="18" height="18" />
      <use href="#is-reg" x="1560" y="600" width="18" height="18" />

      <!-- ============ 1 · SOURCE ============ -->
      <g transform="rotate(-0.3 175 320)">
        <text x="60" y="120" font-size="12" font-weight="700" letter-spacing="2" fill="var(--ink)">01 · SOURCE</text>
        <text x="60" y="140" font-size="9.5" letter-spacing="1.4" fill="var(--grey-label)">SELF-COMPUTING SHEET</text>

        <rect x="60" y="270" width="200" height="120" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.2" />
        <rect x="60" y="270" width="200" height="120" fill="url(#is-ht)" opacity="0.5" />
        <!-- little spreadsheet grid -->
        <g stroke="var(--ink-muted-4)" stroke-width="0.7">
          <line x1="60" y1="300" x2="260" y2="300" />
          <line x1="60" y1="330" x2="260" y2="330" />
          <line x1="60" y1="360" x2="260" y2="360" />
          <line x1="120" y1="270" x2="120" y2="390" />
          <line x1="190" y1="270" x2="190" y2="390" />
        </g>
        <text x="160" y="288" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--ink)">TRACKING SHEET</text>
        <text x="160" y="415" font-size="9" letter-spacing="1" text-anchor="middle" fill="var(--grey-label)">BUFFINI + MLS · LINKED TABS</text>
        <text x="160" y="432" font-size="9" letter-spacing="1" text-anchor="middle" fill="var(--accent)">60+ MIN / WEEK SAVED</text>
      </g>

      <!-- arrow -->
      <path d="M282 330 h58 m0 0 l-9 -5 m9 5 l-9 5" fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />

      <!-- ============ 2 · POWER QUERY ============ -->
      <g transform="rotate(0.3 445 320)">
        <text x="360" y="120" font-size="12" font-weight="700" letter-spacing="2" fill="var(--ink)">02 · POWER QUERY</text>
        <text x="360" y="140" font-size="9.5" letter-spacing="1.4" fill="var(--grey-label)">INGEST + TRANSFORM</text>

        <rect x="360" y="290" width="170" height="80" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.2" />
        <text x="445" y="326" font-size="10.5" font-weight="700" text-anchor="middle" fill="var(--ink)">POWER QUERY</text>
        <text x="445" y="346" font-size="8.5" letter-spacing="0.8" text-anchor="middle" fill="var(--ink-muted-3)">CLEAN · SHAPE · LOAD</text>
      </g>

      <!-- arrow -->
      <path d="M552 330 h58 m0 0 l-9 -5 m9 5 l-9 5" fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />

      <!-- ============ 3 · STAR-SCHEMA MODEL ============ -->
      <g transform="rotate(-0.2 830 330)">
        <text x="630" y="120" font-size="12" font-weight="700" letter-spacing="2" fill="var(--ink)">03 · STAR-SCHEMA MODEL</text>
        <text x="630" y="140" font-size="9.5" letter-spacing="1.4" fill="var(--grey-label)">DAX · SUMX / RELATED</text>

        <!-- relationship lines fact <-> dims -->
        <g stroke="var(--ink-muted-4)" stroke-width="0.9">
          <path d="M830 250 V 300" /><path d="M760 360 L 802 336" /><path d="M900 360 L 858 336" />
        </g>
        <!-- dimensions -->
        <g font-size="8.5" letter-spacing="0.8" text-anchor="middle">
          <rect x="770" y="212" width="120" height="38" fill="var(--bone)" stroke="var(--ink)" stroke-width="1" />
          <text x="830" y="235" fill="var(--ink-muted-2)">DIM · MONTH</text>
          <rect x="648" y="360" width="120" height="38" fill="var(--bone)" stroke="var(--ink)" stroke-width="1" />
          <text x="708" y="383" fill="var(--ink-muted-2)">DIM · AGENT</text>
          <rect x="892" y="360" width="120" height="38" fill="var(--bone)" stroke="var(--ink)" stroke-width="1" />
          <text x="952" y="383" fill="var(--ink-muted-2)">DIM · SUB-TEAM</text>
        </g>
        <!-- fact table, with misregistration echo -->
        <rect x="748" y="300" width="164" height="60" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" transform="translate(3 -3)" />
        <rect x="748" y="300" width="164" height="60" fill="var(--bone)" stroke="var(--accent)" stroke-width="1.6" />
        <rect x="748" y="300" width="164" height="60" fill="url(#is-ht)" opacity="0.4" />
        <text x="830" y="325" font-size="10.5" font-weight="700" text-anchor="middle" fill="var(--ink)">FACT TABLE</text>
        <text x="830" y="343" font-size="8" letter-spacing="0.6" text-anchor="middle" fill="var(--accent)">SALES · CONNECTIONS · REVENUE</text>
      </g>

      <!-- arrow -->
      <path d="M1024 330 h58 m0 0 l-9 -5 m9 5 l-9 5" fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />

      <!-- ============ 4 · INTERACTIVE REPORT ============ -->
      <g transform="rotate(0.3 1310 330)">
        <text x="1100" y="120" font-size="12" font-weight="700" letter-spacing="2" fill="var(--accent)">04 · INTERACTIVE REPORT</text>
        <text x="1100" y="140" font-size="9.5" letter-spacing="1.4" fill="var(--grey-label)">SLICER · METRIC SELECTOR</text>

        <!-- dashboard frame, misregistration echo -->
        <rect x="1100" y="215" width="430" height="230" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" transform="translate(3 -3)" />
        <rect x="1100" y="215" width="430" height="230" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.4" />

        <!-- KPI header row -->
        <g>
          <rect x="1116" y="231" width="90" height="42" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
          <text x="1161" y="252" font-size="11" font-weight="700" text-anchor="middle" fill="var(--ink)">$63.7M</text>
          <text x="1161" y="266" font-size="7" letter-spacing="0.6" text-anchor="middle" fill="var(--grey-label)">VOLUME</text>
          <rect x="1214" y="231" width="90" height="42" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
          <text x="1259" y="252" font-size="11" font-weight="700" text-anchor="middle" fill="var(--ink)">189</text>
          <text x="1259" y="266" font-size="7" letter-spacing="0.6" text-anchor="middle" fill="var(--grey-label)">SALES</text>
          <rect x="1312" y="231" width="90" height="42" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
          <text x="1357" y="252" font-size="11" font-weight="700" text-anchor="middle" fill="var(--ink)">8,523</text>
          <text x="1357" y="266" font-size="7" letter-spacing="0.6" text-anchor="middle" fill="var(--grey-label)">CONNECTIONS</text>
        </g>

        <!-- trend chart -->
        <g>
          <rect x="1116" y="285" width="180" height="145" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
          <text x="1126" y="301" font-size="7.5" letter-spacing="0.8" fill="var(--grey-label)">MONTHLY TREND</text>
          <polyline points="1126,410 1152,398 1178,404 1204,382 1230,388 1256,366 1282,372" fill="none" stroke="var(--accent)" stroke-width="1.4" />
          <polyline points="1126,420 1152,414 1178,416 1204,406 1230,410 1256,398 1282,402" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
        </g>

        <!-- bubble plot -->
        <g>
          <rect x="1306" y="285" width="96" height="145" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
          <text x="1316" y="301" font-size="7.5" letter-spacing="0.6" fill="var(--grey-label)">REV / CONN</text>
          <circle cx="1330" cy="400" r="9" fill="url(#is-ht)" stroke="var(--ink)" stroke-width="0.8" />
          <circle cx="1356" cy="378" r="13" fill="url(#is-ht)" stroke="var(--accent)" stroke-width="0.9" />
          <circle cx="1380" cy="410" r="6" fill="url(#is-ht)" stroke="var(--ink)" stroke-width="0.8" />
          <circle cx="1372" cy="355" r="8" fill="url(#is-ht)" stroke="var(--ink)" stroke-width="0.8" />
        </g>

        <!-- slicer tab -->
        <rect x="1418" y="215" width="112" height="230" fill="var(--bone)" stroke="var(--ink-muted-4)" stroke-width="0.9" stroke-dasharray="3 3" />
        <text x="1474" y="238" font-size="8" font-weight="700" letter-spacing="1" text-anchor="middle" fill="var(--accent)">SLICER</text>
        <g font-size="7.5" letter-spacing="0.5" text-anchor="middle" fill="var(--ink-muted-3)">
          <text x="1474" y="262">ANY AGENT</text>
          <text x="1474" y="282">SUB-TEAM</text>
          <text x="1474" y="302">METRIC</text>
        </g>
        <g stroke="var(--ink-muted-4)" stroke-width="0.8" fill="none">
          <rect x="1432" y="315" width="84" height="14" /><rect x="1432" y="335" width="84" height="14" />
          <rect x="1432" y="355" width="84" height="14" />
        </g>
      </g>

      <text x="60" y="560" font-size="11" letter-spacing="1.4" fill="var(--ink-muted-4)">ONE LIVE VIEW · FILTERABLE TO ANY AGENT OR SUB-TEAM · SELF-INITIATED, STILL IN USE</text>
    </svg>
  </div>
</figure>

<style>
  .fig { margin: 12vh 0 0; }
  .fig-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--grey-label);
    margin-bottom: 4vh;
  }
  .fig-accent { color: var(--accent); font-weight: 500; }
  .fig-scroll { overflow-x: auto; }
  @media (max-width: 720px) {
    .fig-scroll svg { min-width: 1100px; }
  }
</style>
