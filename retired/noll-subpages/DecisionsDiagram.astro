---
// FIG. 1 — Three questions leadership had, each turned into an analysis they
// acted on. A question -> analysis -> decision matrix, one row per question.
import DiagramDefs from './DiagramDefs.astro';

const rows = [
  {
    q: 'Do relationships actually drive revenue?',
    a: ['Revenue-per-connection model', '9 agents · Python · multi-year data'],
    d: ['A managed coaching metric', 'The firm’s premise, made trackable'],
  },
  {
    q: 'Is a luxury division worth it?',
    a: ['20 years of transaction data', '$500K threshold · 11% of sales, 31% of revenue'],
    d: ['Noll Reserve launched', 'Flagship listing at $6.75M'],
  },
  {
    q: 'Does staging pay off?',
    a: ['12-closing controlled comparison', '9 vs 38 days · 100.8% vs 97.9% of list'],
    d: ['Adopted as NTI’s sales pitch', 'The staging arm’s actual case'],
  },
];
---

<figure class="fig" data-reveal>
  <figcaption class="fig-label">
    <span class="fig-accent">FIG. 1</span>&nbsp;&nbsp;QUESTION · ANALYSIS · DECISION
  </figcaption>
  <div class="fig-scroll">
    <svg
      viewBox="0 0 1600 620"
      role="img"
      aria-label="A three-row matrix. Each row moves from a leadership question, to the analysis built to answer it, to the decision it drove: relationships and revenue leads to a coaching metric; a luxury division question leads to Noll Reserve; a staging question leads to NTI's sales pitch."
      style="font-family: var(--font-sans); width: 100%; height: auto; display: block;"
    >
      <DiagramDefs prefix="dd" />

      <use href="#dd-reg" x="22" y="22" width="18" height="18" />
      <use href="#dd-reg" x="1560" y="22" width="18" height="18" />
      <use href="#dd-reg" x="22" y="580" width="18" height="18" />
      <use href="#dd-reg" x="1560" y="580" width="18" height="18" />

      <!-- column headers -->
      <text x="80" y="80" font-size="12" font-weight="700" letter-spacing="2.4" fill="var(--grey-label)">QUESTION</text>
      <text x="620" y="80" font-size="12" font-weight="700" letter-spacing="2.4" fill="var(--grey-label)">ANALYSIS</text>
      <text x="1180" y="80" font-size="12" font-weight="700" letter-spacing="2.4" fill="var(--accent)">DECISION</text>
      <line x1="80" y1="96" x2="1520" y2="96" stroke="var(--grey-faint)" stroke-width="1" stroke-dasharray="6 6" />

      {rows.map((r, i) => {
        const cy = 190 + i * 138;
        const rot = [-0.3, 0.25, -0.2][i];
        return (
          <g transform={`rotate(${rot} 800 ${cy})`}>
            <!-- question -->
            <text x="80" y={cy - 6} font-size="17" font-weight="400" fill="var(--ink)" style="font-family: var(--font-display);">{r.q}</text>

            <!-- arrow q -> a -->
            <path d={`M470 ${cy - 12} h74 m0 0 l-9 -5 m9 5 l-9 5`} fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />

            <!-- analysis box -->
            <rect x="600" y={cy - 46} width="480" height="70" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
            <rect x="600" y={cy - 46} width="480" height="70" fill="url(#dd-ht)" opacity="0.4" />
            <text x="620" y={cy - 20} font-size="12.5" font-weight="700" fill="var(--ink)">{r.a[0]}</text>
            <text x="620" y={cy + 2} font-size="9.5" letter-spacing="0.8" fill="var(--ink-muted-3)">{r.a[1]}</text>

            <!-- arrow a -> d -->
            <path d={`M1082 ${cy - 12} h74 m0 0 l-9 -5 m9 5 l-9 5`} fill="none" stroke="var(--accent)" stroke-width="1" />

            <!-- decision box, with misregistration echo -->
            <rect x="1180" y={cy - 46} width="340" height="70" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" transform="translate(3 -3)" />
            <rect x="1180" y={cy - 46} width="340" height="70" fill="var(--bone)" stroke="var(--accent)" stroke-width="1.5" />
            <text x="1200" y={cy - 20} font-size="12.5" font-weight="700" fill="var(--ink)">{r.d[0]}</text>
            <text x="1200" y={cy + 2} font-size="9.5" letter-spacing="0.8" fill="var(--accent)">{r.d[1]}</text>
          </g>
        );
      })}
    </svg>
  </div>
</figure>

<style>
  .fig { margin: 12vh 0 0; }
  .fig-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--grey-label);
    margin-bottom: 4vh;
  }
  .fig-accent { color: var(--accent); font-weight: 500; }
  .fig-scroll { overflow-x: auto; }
  @media (max-width: 720px) {
    .fig-scroll svg { min-width: 1100px; }
  }
</style>
