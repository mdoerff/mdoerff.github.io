---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Michael Doerffler" description="This page does not exist. Head back to the case studies.">
  <section class="nf" aria-label="Page not found">
    <div class="nf-inner">
      <div class="sec-label">PAGE NOT FOUND</div>
      <h1 class="nf-title">This page went<span class="nf-title-2">unrecorded.</span></h1>
      <p class="nf-line">The address may have changed, or it never existed. Everything worth reading is one step away.</p>
      <a href="/" class="nf-back">BACK TO THE FRONT PAGE &rarr;</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    z-index: 2;
    min-height: 62vh;
    display: flex;
    align-items: center;
    padding: 14vh 4vw 6vh;
  }
  .nf-inner { max-width: 820px; }
  .nf-title {
    margin: 26px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 4.6vw, 62px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .nf-title-2 { display: block; color: var(--accent); }
  .nf-line {
    margin: 26px 0 0;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.6;
    color: var(--ink-muted-2);
    max-width: 520px;
  }
  .nf-back {
    display: inline-block;
    margin-top: 34px;
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 3px;
    transition: color 0.15s;
  }
  .nf-back:hover { color: var(--accent); }

  @media (max-width: 720px) {
    .nf { padding: 12vh 6vw 4vh; }
  }
</style>
