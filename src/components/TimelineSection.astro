---
// Timeline: an ascending plot of the full work history, 2020 → 2026.
// Precision aesthetic: clean bone ground, sharp line, weighted nodes.
// Time is deliberately warped: the scrappy 2020-22 cluster stays tight,
// the quiet 2023-24 stretch is compressed, and the significant 2025-26
// run gets the most room. Hover/tap/focus a node for detail on demand.
// Hover copy is PLACEHOLDER until Michael supplies the real lines.

// Piecewise time → x mapping (decimal year → svg x).
const ANCHORS: [number, number][] = [
  [2020.42, 70],
  [2023.0, 500],
  [2024.35, 665],
  [2027.05, 1390],
];
const xFor = (d: number) => {
  for (let i = 1; i < ANCHORS.length; i++) {
    if (d <= ANCHORS[i][0]) {
      const [d0, x0] = ANCHORS[i - 1];
      const [d1, x1] = ANCHORS[i];
      return x0 + ((d - d0) / (d1 - d0)) * (x1 - x0);
    }
  }
  return ANCHORS[ANCHORS.length - 1][1];
};

// The line: one deliberate rise.
const LX0 = 70, LY0 = 232, LX1 = 1390, LY1 = 76;
const yFor = (x: number) => LY0 + ((x - LX0) / (LX1 - LX0)) * (LY1 - LY0);

// All 18 entries, exact order and dates from Michael. w = visual weight:
// 1 small blip · 2 mid · 3 major. future = open node past today.
const entries = [
  { start: 'JUN 2020', end: 'MAR 2022', title: 'Salsa Grille', d: 2020.42, w: 1 },
  { start: 'SEP 2020', end: 'MAR 2021', title: 'YMCA, referee', d: 2020.67, w: 1 },
  { start: 'FEB 2021', end: 'JUL 2021', title: "Wendy's", d: 2021.08, w: 1 },
  { start: 'FALL 2021', end: 'FALL 2022', title: 'Homestead Investment Club, founded', d: 2021.7, w: 2 },
  { start: 'FEB 2022', end: 'JUN 2022', title: 'Catalyst Fitness, receptionist', d: 2022.08, w: 1 },
  { start: 'JUN 2022', end: 'JAN 2023', title: 'Middle America Homes, real estate sales and marketing intern', d: 2022.42, w: 2 },
  { start: 'FALL 2023', end: 'SPRING 2024', title: 'Tutor', d: 2023.7, w: 1 },
  { start: 'SUMMER 2024', end: 'FALL 2024', title: 'BM Solutions, co-founded', d: 2024.45, w: 2 },
  { start: 'FALL 2024', end: null, title: 'Switched major to AI & Business Analytics', d: 2024.7, w: 3 },
  { start: 'FALL 2024', end: 'FALL 2024', title: 'Peer Leader, Bulls Business Community', d: 2024.7, w: 2 },
  { start: 'FEB 2025', end: 'AUG 2025', title: 'Delta Tau Delta, Social Media Chair', d: 2025.08, w: 1 },
  { start: 'SPRING 2025', end: 'SPRING 2025', title: "Dick's Sporting Goods", d: 2025.2, w: 1 },
  { start: 'MAY 2025', end: 'AUG 2025', title: '3Rivers Federal Credit Union, BI intern', d: 2025.33, w: 2 },
  { start: 'MAY 2025', end: 'JAN 2026', title: 'Noll Team, analytics', d: 2025.33, w: 3 },
  { start: 'AUG 2025', end: 'AUG 2026', title: 'Delta Tau Delta, VP of Programming', d: 2025.58, w: 2 },
  { start: 'APR 2026', end: 'JUL 2026', title: 'Florida DOH', d: 2026.25, w: 3 },
  { start: 'MAY 2026', end: 'AUG 2026', title: 'A-LIGN, BDR', d: 2026.33, w: 3 },
  { start: 'DEC 2026', end: null, title: 'Graduation', d: 2026.92, w: 3, future: true },
];

// Plot positions, nudging same-date entries apart so every node is hoverable.
const MIN_GAP = 15;
let lastX = -Infinity;
const nodes = entries.map((e) => {
  let x = xFor(e.d);
  if (x < lastX + MIN_GAP) x = lastX + MIN_GAP;
  lastX = x;
  return { ...e, x, y: yFor(x) };
});

const NOW = 2026.55; // solid ink through today; dashed ahead
const xNow = xFor(NOW);
const R = { 1: 3.2, 2: 5, 3: 7 } as const;
const years = [2021, 2022, 2023, 2024, 2025, 2026];
---

<section id="timeline" class="tl" aria-label="Timeline">
  <div class="tl-head" data-reveal>
    <div class="sec-label">TIMELINE</div>
    <p class="tl-sub">
      A first job in June 2020, a degree in December 2026, and eighteen entries between them. The
      line never flattens.
    </p>
    <p class="tl-note">Rest on a node for the detail.</p>
  </div>

  <div class="plot-wrap" data-reveal>
    <div class="tl-card" id="tl-card" aria-hidden="true">
      <p class="card-dates" id="card-dates"></p>
      <p class="card-title" id="card-title"></p>
      <p class="card-text" id="card-text"></p>
    </div>

    <div class="strip-hint" aria-hidden="true">SCROLL THE PLOT · TAP A NODE &rarr;</div>
    <div class="strip" id="tl-strip">
      <svg viewBox="0 0 1600 300" id="tl-svg" style="width: 100%; height: auto; display: block;" aria-hidden="true">
        <!-- baseline + year ticks -->
        <line x1="70" y1="262" x2="1390" y2="262" stroke="rgba(41,33,23,0.18)" stroke-width="1" />
        {years.map((yr) => (
          <g>
            <line x1={xFor(yr)} y1="258" x2={xFor(yr)} y2="266" stroke="rgba(41,33,23,0.4)" stroke-width="1" />
            <text x={xFor(yr)} y="284" font-size="11" letter-spacing="1.5" text-anchor="middle" fill="var(--grey-label)" style="font-family: var(--font-sans);">{yr}</text>
          </g>
        ))}

        <!-- the rise: solid ink through today, dashed ahead, trailing open -->
        <line class="tl-line-draw" x1={LX0} y1={LY0} x2={xNow} y2={yFor(xNow)} stroke="var(--ink)" stroke-width="2" />
        <line x1={xNow} y1={yFor(xNow)} x2={LX1} y2={LY1} stroke="rgba(41,33,23,0.45)" stroke-width="1.6" stroke-dasharray="5 6" />
        <path d={`M ${LX1} ${LY1} L 1490 ${LY1 - 14} L 1566 ${LY1 - 24}`} fill="none" stroke="rgba(41,33,23,0.4)" stroke-width="1.4" stroke-dasharray="3 7" />
        <path d={`M 1566 ${LY1 - 24} l -9 -1 m 9 1 l -7 6`} fill="none" stroke="rgba(41,33,23,0.55)" stroke-width="1.3" />
        <text x="1578" y={LY1 - 36} font-size="10" letter-spacing="1.6" text-anchor="end" fill="var(--ink-muted-4)" style="font-family: var(--font-sans);">STILL DRAWING</text>

        <!-- origin annotation: the humble anchor, clear of the axis -->
        <text x="70" y={LY0 + 26} font-size="10" letter-spacing="1.6" fill="var(--ink-muted-4)" style="font-family: var(--font-sans);">JUN 2020 · THE FIRST JOB</text>

        <!-- the eighteen nodes, weighted -->
        {nodes.map((n, i) => (
          <g
            class={`tnode tnode-w${n.w} ${n.future ? 'tnode-future' : ''}`}
            data-i={i}
            tabindex="0"
            role="button"
            aria-label={`${n.title}. ${n.start}${n.end ? ' to ' + n.end : ''}.`}
            style={`--rd: ${i * 0.06}s;`}
          >
            <circle class="tnode-hit" cx={n.x} cy={n.y} r="14" fill="transparent" />
            {n.w === 3 && <circle class="tnode-halo" cx={n.x} cy={n.y} r={R[3] + 6} fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" />}
            {n.future ? (
              <circle class="tnode-dot" cx={n.x} cy={n.y} r={R[3]} fill="var(--bone)" stroke="var(--accent)" stroke-width="2" />
            ) : (
              <circle class="tnode-dot" cx={n.x} cy={n.y} r={R[n.w as 1 | 2 | 3]} fill={n.w === 3 ? 'var(--accent)' : 'var(--ink)'} opacity={n.w === 1 ? 0.75 : 1} />
            )}
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<script>
  function initTimeline() {
    const strip = document.getElementById('tl-strip');
    const card = document.getElementById('tl-card');
    if (!strip || !card || (strip as HTMLElement).dataset.armed) return;
    (strip as HTMLElement).dataset.armed = '1';

    const cardDates = document.getElementById('card-dates')!;
    const cardTitle = document.getElementById('card-title')!;
    const cardText = document.getElementById('card-text')!;
    const wrap = card.parentElement as HTMLElement;
    const nodes = [...strip.querySelectorAll<SVGGElement>('.tnode')];

    // Placeholder detail lines until Michael supplies the real hover copy.
    const data = nodes.map((n) => {
      const label = n.getAttribute('aria-label') || '';
      const [title, dates] = label.split('. ');
      return { title, dates: (dates || '').replace(/\.$/, ''), text: 'One to two sentences of detail land here.' };
    });

    let shown = -1;
    const show = (i: number) => {
      const n = nodes[i];
      const dot = n.querySelector('.tnode-dot') as SVGCircleElement;
      const cx = parseFloat(dot.getAttribute('cx')!);
      const svg = strip.querySelector('svg')!;
      const svgRect = svg.getBoundingClientRect();
      const wrapRect = wrap.getBoundingClientRect();
      const px = svgRect.left - wrapRect.left + (cx / 1600) * svgRect.width;
      const clamped = Math.min(wrapRect.width - 150, Math.max(150, px));
      card.style.left = clamped + 'px';
      cardDates.textContent = data[i].dates;
      cardTitle.textContent = data[i].title;
      cardText.textContent = data[i].text;
      card.classList.add('tl-card-on');
      nodes.forEach((m, k) => m.classList.toggle('tnode-on', k === i));
      shown = i;
    };
    const hide = () => {
      card.classList.remove('tl-card-on');
      nodes.forEach((m) => m.classList.remove('tnode-on'));
      shown = -1;
    };

    nodes.forEach((n, i) => {
      n.addEventListener('pointerenter', () => show(i));
      n.addEventListener('focus', () => show(i));
      n.addEventListener('blur', hide);
      n.addEventListener('click', (e) => {
        e.stopPropagation();
        shown === i ? hide() : show(i);
      });
    });
    strip.addEventListener('pointerleave', hide);
    document.addEventListener('click', (e) => {
      if (!strip.contains(e.target as Node)) hide();
    });
    document.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') hide();
    });
  }
  document.addEventListener('astro:page-load', initTimeline);
</script>

<style>
  /* Clean bone ground: this section sits on paper, not atmosphere.
     (The film grain overlay in Base sits above everything, so it stays.) */
  .tl {
    position: relative;
    z-index: 2;
    padding: 16vh 4vw 12vh;
    scroll-margin-top: 4vh;
  }
  .tl-sub {
    margin: 16px 0 0;
    max-width: 820px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.7vw, 25px);
    line-height: 1.4;
    color: var(--ink);
    text-wrap: pretty;
  }
  .tl-note {
    margin: 10px 0 0;
    font-family: var(--font-sans);
    font-size: clamp(13px, 1.05vw, 14.5px);
    color: var(--ink-muted-4);
  }

  .plot-wrap { position: relative; margin-top: 8vh; }

  /* Hover card: one card, repositioned per node. 1-2 sentences max. */
  .tl-card {
    position: absolute;
    top: -8px;
    transform: translate(-50%, -100%);
    width: 290px;
    padding: 14px 16px;
    background: var(--bone);
    border: 1px solid rgba(41, 33, 23, 0.4);
    box-shadow: 3px 3px 0 rgba(46, 74, 58, 0.14);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
    z-index: 5;
  }
  .tl-card-on { opacity: 1; }
  .card-dates {
    margin: 0 0 6px;
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  .card-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 16.5px;
    line-height: 1.25;
    color: var(--ink);
  }
  .card-text {
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--ink-muted-3);
  }

  .strip { cursor: crosshair; }
  .strip-hint { display: none; }

  .tnode { cursor: pointer; outline: none; }
  .tnode-dot { transition: r 0.18s ease; }
  .tnode:hover .tnode-dot, .tnode:focus-visible .tnode-dot, .tnode-on .tnode-dot { r: 9; }
  .tnode-halo { transition: opacity 0.2s; }
  .tnode:hover .tnode-halo, .tnode-on .tnode-halo { opacity: 0.7; }
  .tnode:focus-visible .tnode-dot { stroke: var(--accent); stroke-width: 2; }

  /* Draw-on-reveal: the solid line draws, nodes settle in sequence. */
  @media (prefers-reduced-motion: no-preference) {
    .tl-line-draw {
      stroke-dasharray: 1600;
      stroke-dashoffset: 1600;
    }
    .plot-wrap.is-visible .tl-line-draw {
      animation: tl-draw 1.6s var(--ease-mech) forwards;
    }
    .tnode { opacity: 0; }
    .plot-wrap.is-visible .tnode {
      animation: tl-node 0.4s ease forwards;
      animation-delay: calc(0.55s + var(--rd));
    }
  }
  @keyframes tl-draw { to { stroke-dashoffset: 0; } }
  @keyframes tl-node { to { opacity: 1; } }

  @media (max-width: 720px) {
    .tl { padding: 12vh 6vw 10vh; }
    .plot-wrap { margin-top: 5vh; }
    .strip { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .strip svg { min-width: 1200px; }
    .strip-hint {
      display: block;
      margin-bottom: 2.5vh;
      font-family: var(--font-sans);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--grey-label);
    }
    .tl-card { width: 250px; }
  }
</style>
