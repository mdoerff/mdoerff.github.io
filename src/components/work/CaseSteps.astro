---
// The engagement framework: numbered phases, each with an "artifact" caption.
interface Step {
  phase: string;    // e.g. "DISCOVER"
  title: string;
  body: string;
  artifact: string; // small factual caption, e.g. "STAFF INTERVIEWS · 50+ COUNTY DOCUMENTS"
}
interface Props { steps: Step[] }
const { steps } = Astro.props;
---

<div class="steps">
  {steps.map((s, i) => (
    <div class="step" data-reveal>
      <div class="step-phase">
        <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
        {s.phase}
      </div>
      <h3 class="step-title">{s.title}</h3>
      <p class="step-body">{s.body}</p>
      <div class="step-artifact">{s.artifact}</div>
    </div>
  ))}
</div>

<style>
  .steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 6vw;
    row-gap: 9vh;
    margin-top: 7vh;
  }
  /* the right column rides lower for editorial asymmetry */
  .step:nth-child(even) { transform: translateY(6vh); }

  .step-phase {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--ink-muted-4);
    margin-bottom: 16px;
  }
  .step-num { color: var(--accent); margin-right: 10px; }

  .step-title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.25;
    color: var(--ink);
  }
  .step-body {
    margin: 0 0 18px;
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-muted-3);
    max-width: 520px;
    text-wrap: pretty;
  }
  .step-artifact {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--grey-label);
  }

  @media (max-width: 720px) {
    .steps { grid-template-columns: 1fr; row-gap: 6vh; margin-top: 5vh; }
    .step:nth-child(even) { transform: none; }
  }
</style>
