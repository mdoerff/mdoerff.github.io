---
// Shared shell for every case study page: sticky bar, title block, footer.
// Body sections come in through the default slot.
interface Props {
  caseLabel: string;      // sticky bar label, e.g. "FLORIDA DOH · PERMIT MODERNIZATION"
  eyebrow: string;        // e.g. "GOVERNMENT · PROCESS AUTOMATION"
  titleLine1: string;
  titleLine2?: string;    // second headline line, set in accent
  standfirst: string;
  nextLabel: string;      // footer: next case name
  nextNote?: string;      // shown only when the next case isn't linked yet
  nextHref?: string;      // when present, NEXT renders as a link
}
const { caseLabel, eyebrow, titleLine1, titleLine2, standfirst, nextLabel, nextNote = 'IN PREPARATION', nextHref } = Astro.props;
---

<div class="case">
  <div class="case-bar">
    <span class="case-bar-label">{caseLabel}</span>
    <a href="/#work" class="case-bar-back">BACK TO CASE STUDIES</a>
  </div>

  <article class="case-body">
    <header class="case-head">
      <div class="sec-label" data-reveal>{eyebrow}</div>
      <h1 class="case-title" data-reveal>
        {titleLine1}
        {titleLine2 && <span class="case-title-2">{titleLine2}</span>}
      </h1>
      <p class="case-stand" data-reveal>{standfirst}</p>
    </header>

    <slot />

    <footer class="case-footer" data-reveal>
      {nextHref ? (
        <a href={nextHref} class="case-next case-next-live">NEXT · {nextLabel} &rarr;</a>
      ) : (
        <span class="case-next">NEXT · {nextLabel} <span class="case-next-note">{nextNote}</span></span>
      )}
      <a href="/#work" class="case-bar-back">BACK TO CASE STUDIES &uarr;</a>
    </footer>
  </article>
</div>

<style>
  .case { position: relative; z-index: 2; }

  .case-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 4vw;
    background: rgba(233, 225, 207, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(41, 33, 23, 0.12);
  }

  /* `backdrop-filter` on a sticky bar re-samples and re-blurs the strip of
     page behind it every scroll frame — the one region guaranteed to be
     changing while you scroll. On a phone that is a per-frame blur running
     the length of every case page. At 0.96 alpha there is nothing left to
     see through, so the blur was buying an effect no one could observe.
     Desktop keeps the glass. */
  @media (hover: none) {
    .case-bar {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgba(233, 225, 207, 0.96);
    }
  }
  .case-bar-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--ink-muted-4);
  }
  .case-bar-back {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-muted-3);
    transition: color 0.15s;
  }
  .case-bar-back:hover { color: var(--accent); }

  /* Centered column: the measure caps stay, but the whitespace splits into
     balanced margins on wide screens instead of piling up on the right */
  .case-body {
    max-width: calc(1150px + 8vw);
    margin: 0 auto;
    padding: 0 4vw 3vh;
  }

  .case-head { padding: 6vh 0 4vh; max-width: 1150px; }
  .case-title {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 3.9vw, 52px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .case-title-2 { display: block; color: var(--accent); }
  .case-stand {
    margin: 20px 0 0;
    max-width: 820px;
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }

  .case-footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-top: 14vh;
    padding-top: 4vh;
    border-top: 1px solid rgba(41, 33, 23, 0.12);
  }
  .case-next {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--ink-muted-4);
  }
  /* grey-label, not grey-faint: this is small text and grey-faint sits at
     3.03:1 on paper. grey-faint stays the token for diagram strokes and
     decorative glyphs, which carry no contrast requirement. */
  .case-next-note { color: var(--grey-label); }
  a.case-next-live { transition: color 0.15s; }
  a.case-next-live:hover { color: var(--accent); }

  @media (max-width: 720px) {
    .case-bar { padding: 12px 6vw; }
    .case-bar-label { display: none; }
    .case-body { padding: 0 6vw 3vh; }
    .case-head { padding: 5vh 0 3.5vh; }
    .case-footer { flex-direction: column; gap: 14px; margin-top: 10vh; }
  }
</style>
