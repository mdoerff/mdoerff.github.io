---
// Balanced impact: a modest metrics block set beside qualitative outcomes at
// equal visual weight (not the big number-wall of CaseStats). Optional note +
// disclaimer for labeled estimates / testing-phase caveats.
interface Metric {
  value: string;
  label: string;
}
interface Props {
  metrics: Metric[];
  outcomes?: string[];
  note?: string;
  disclaimer?: string;
}
const { metrics, outcomes = [], note, disclaimer } = Astro.props;
---

<div class="impact" data-reveal>
  <div class="impact-grid">
    <div class="metrics">
      {metrics.map((m) => (
        <div class="metric">
          <div class="metric-value">{m.value}</div>
          <div class="metric-label">{m.label}</div>
        </div>
      ))}
    </div>
    {outcomes.length > 0 && (
      <ul class="outcomes">
        {outcomes.map((o) => <li>{o}</li>)}
      </ul>
    )}
  </div>
  {note && <p class="impact-note">{note}</p>}
  {disclaimer && <p class="impact-disclaimer">{disclaimer}</p>}
</div>

<style>
  .impact { margin-top: 6vh; }
  .impact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: 5vh 6vw;
    align-items: start;
  }
  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4.5vh 3vw;
  }
  .metric-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.05;
    color: var(--ink);
  }
  .metric-label {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--grey-label);
    line-height: 1.6;
  }
  .outcomes {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .outcomes li {
    position: relative;
    padding-left: 26px;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.55;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }
  .outcomes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12px;
    width: 12px;
    height: 1px;
    background: var(--accent);
  }
  .impact-note {
    margin: 6vh 0 0;
    max-width: 720px;
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.65;
    color: var(--ink-muted-3);
    text-wrap: pretty;
  }
  .impact-disclaimer {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--grey-faint);
  }
  @media (max-width: 720px) {
    .impact-grid { grid-template-columns: 1fr; gap: 4vh 0; }
    .metrics { gap: 3.5vh 4vw; }
  }
</style>
