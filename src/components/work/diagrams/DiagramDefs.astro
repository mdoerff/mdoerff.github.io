---
// Shared hand-drawn texture for all case diagrams: halftone fill + registration mark.
// `prefix` namespaces the ids in case two diagrams ever share a page.
//
// Conventions used by every diagram (attribute patterns, not components):
//  - slight rotation: wrap a panel in <g transform="rotate(-0.4 cx cy)">
//  - misregistration echo: duplicate a key rect, accent stroke, translate(3 -3), low opacity
//  - colors come from the site tokens: var(--ink), var(--accent), var(--grey-label)...
interface Props { prefix: string }
const { prefix } = Astro.props;
---
<defs>
  <pattern id={`${prefix}-ht`} width="5" height="5" patternUnits="userSpaceOnUse">
    <circle cx="1.3" cy="1.3" r="0.75" fill="var(--ink)" opacity="0.3" />
  </pattern>
  <symbol id={`${prefix}-reg`} viewBox="0 0 20 20">
    <path d="M10 1V19M1 10H19" stroke="var(--grey-faint)" stroke-width="0.9" />
    <circle cx="10" cy="10" r="4.5" fill="none" stroke="var(--grey-faint)" stroke-width="0.9" />
  </symbol>
</defs>
