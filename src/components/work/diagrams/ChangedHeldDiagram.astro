---
// What changed, and what held: a working starting state, four external
// pressures that arrived as a set, and the three decisions that held
// through all of them. The four-versus-three asymmetry is the exhibit.
const moved = [
  'CMMC paused federally',
  'SOC 2 became the priority, and its accounts got more valuable',
  "The SOC 2 target signal sits in Salesforce, where Apollo can't read it",
  'The person who could fix that became unavailable',
];
const held = [
  'Qualification stays layered',
  'Pause the run rather than burn scarce accounts',
  'The human stays in the loop',
];
---

<figure class="ch" aria-label="What changed and what held: the workflow was proven on CMMC with about 1% bounce across fourteen reps; four external pressures arrived at once, and three decisions held through all of them.">
  <div class="ch-state" data-reveal>
    <span class="ch-state-label">Where it stood</span>
    <span class="ch-state-line">Proven on CMMC, about 1% bounce against a 6% team average, running across fourteen reps.</span>
  </div>

  <div class="ch-group" data-reveal>
    <p class="ch-label">What changed, all at once</p>
    <div class="ch-grid ch-grid-moved">
      {moved.map((m) => <span class="ch-cell ch-cell-moved">{m}</span>)}
    </div>
  </div>

  <div class="ch-group" data-reveal>
    <p class="ch-label ch-label-held">What held</p>
    <div class="ch-grid ch-grid-held">
      {held.map((h) => <span class="ch-cell ch-cell-held">{h}</span>)}
    </div>
  </div>
</figure>

<style>
  .ch { margin: 0 0 5vh; }

  .ch-state {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
    padding: 14px 18px;
    border: 1px solid rgba(46, 74, 58, 0.4);
    background: rgba(46, 74, 58, 0.06);
  }
  .ch-state-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    white-space: nowrap;
  }
  .ch-state-line {
    font-family: var(--font-display);
    font-size: clamp(13.5px, 1.15vw, 16px);
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }

  .ch-group { margin-top: 3.5vh; }
  .ch-label {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--grey-label);
  }
  .ch-label-held { color: var(--accent); }

  .ch-grid { display: grid; gap: 12px; }
  .ch-grid-moved { grid-template-columns: repeat(4, 1fr); }
  .ch-grid-held { grid-template-columns: repeat(3, 1fr); }

  .ch-cell {
    padding: 13px 14px;
    font-family: var(--font-sans);
    font-size: clamp(12.5px, 1.05vw, 14px);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .ch-cell-moved {
    border: 1px solid rgba(41, 33, 23, 0.28);
    color: var(--ink-muted-3);
  }
  .ch-cell-held {
    border: 1px solid rgba(46, 74, 58, 0.4);
    background: rgba(46, 74, 58, 0.06);
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .ch-grid-moved { grid-template-columns: 1fr 1fr; }
    .ch-grid-held { grid-template-columns: 1fr; }
  }
</style>
