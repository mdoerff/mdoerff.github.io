---
// Surface area map: one role down the middle, the parts of the business it
// reached branching off either side. Its only job is breadth, so every line
// here is written for the business and none of them names a tool or explains
// how anything was built. That belongs to the section underneath.
const branches = [
  {
    side: 'left',
    title: 'Executive reporting',
    line: 'Performance review became a standing cycle instead of an ad hoc conversation, and leadership reads the numbers without asking anyone for them.',
  },
  {
    side: 'right',
    title: 'Back-office operations',
    line: 'Weekly tracking stopped being somebody\'s manual chore, and ownership went back to the office rather than staying with me.',
  },
  {
    side: 'left',
    title: 'Field performance',
    line: 'Nine agents kept their numbers nine different ways. Now they sit side by side, and relationship activity is something leadership can hold people to.',
  },
  {
    side: 'right',
    title: 'Voice of the client',
    line: "Six years of client feedback nobody had read end to end now reaches the CEO as coaching material, agent by agent.",
  },
  {
    side: 'left',
    title: 'Segment strategy',
    line: 'Twenty years of transactions showed how much of the revenue sat in a thin slice at the top, and that finding went into the decision to launch Noll Reserve.',
  },
  {
    side: 'right',
    title: 'Service line economics',
    line: "Noll Team Interiors got a case for what staging is worth, made out of the team's own closings rather than an industry statistic.",
  },
];
---

<figure
  class="sa"
  data-reveal
  aria-label="The domains the role reached: executive reporting, back-office operations, field performance, voice of the client, segment strategy, and service line economics."
>
  <p class="sa-head">AI AND BUSINESS STRATEGY INTERN</p>

  <div class="sa-spine">
    {branches.map((b) => (
      <div class={`sa-row sa-${b.side}`}>
        <div class="sa-slot sa-slot-l">
          {b.side === 'left' && (
            <div class="sa-branch">
              <p class="sa-title">{b.title}</p>
              <p class="sa-line">{b.line}</p>
            </div>
          )}
        </div>
        <div class="sa-tick" aria-hidden="true"></div>
        <div class="sa-slot sa-slot-r">
          {b.side === 'right' && (
            <div class="sa-branch">
              <p class="sa-title">{b.title}</p>
              <p class="sa-line">{b.line}</p>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</figure>

<style>
  .sa { margin: 5vh 0 0; }

  .sa-head {
    margin: 0 0 1.4vh;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--accent);
  }

  /* The rule down the middle is the role; branches hang off it */
  .sa-spine { position: relative; }
  .sa-spine::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: var(--accent);
  }

  .sa-row {
    display: grid;
    grid-template-columns: 1fr 68px 1fr;
    align-items: center;
    padding: 2.4vh 0;
  }
  .sa-slot { min-width: 0; }
  .sa-slot-l { text-align: right; padding-right: 4px; }
  .sa-slot-r { padding-left: 4px; }
  .sa-tick { height: 1px; background: rgba(41, 33, 23, 0.3); }

  .sa-title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.25;
    color: var(--ink);
  }
  .sa-line {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(12px, 1.05vw, 13.5px);
    line-height: 1.6;
    color: var(--grey-label);
    text-wrap: pretty;
  }

  /* Phones: the rule moves to the edge and every branch sits to its right */
  @media (max-width: 760px) {
    .sa-head { text-align: left; padding-left: 22px; }
    .sa-spine::before { left: 1px; margin-left: 0; }
    .sa-row { grid-template-columns: 1fr; padding: 2vh 0 2vh 22px; }
    .sa-slot-l { text-align: left; padding-right: 0; }
    .sa-slot-r { padding-left: 0; }
    .sa-slot:empty { display: none; }
    .sa-tick { display: none; }
    .sa-title { font-size: 16px; }
  }
</style>
