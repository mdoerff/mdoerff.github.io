<script>
  function initPdFlip() {
    const wrap = document.querySelector('.pd-flip');
    if (!wrap || (wrap as HTMLElement).dataset.armed) return;
    (wrap as HTMLElement).dataset.armed = '1';
    const btns = [...wrap.querySelectorAll<HTMLButtonElement>('.flip-btn')];
    const panels = {
      found: wrap.querySelector('.flip-found')!,
      built: wrap.querySelector('.flip-built')!,
    };
    btns.forEach((b) => {
      b.addEventListener('click', () => {
        const which = b.dataset.flip as 'found' | 'built';
        btns.forEach((x) => {
          const on = x === b;
          x.classList.toggle('flip-btn-on', on);
          x.setAttribute('aria-pressed', String(on));
        });
        panels.found.classList.toggle('flip-on', which === 'found');
        panels.built.classList.toggle('flip-on', which === 'built');
      });
    });
  }
  document.addEventListener('astro:page-load', initPdFlip);
</script>

