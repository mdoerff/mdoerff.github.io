---
// Florida DOH permit intake, as found and as built.
// Left: the real "before" — four people, disconnected copies, point-to-point
// email, no shared center. Right: the same team connected to one shared
// system of record. Every label is a real fact from the engagement.
// Type floor: nothing under ~11.5 SVG units, so the smallest text still
// renders legibly after the 1600-unit canvas scales into the content column.
import DiagramDefs from './DiagramDefs.astro';
