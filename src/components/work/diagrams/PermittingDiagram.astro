---
// Florida DOH permit intake, as found and as built.
// Left: the real "before" — four people, disconnected copies, point-to-point
// email, no shared center. Right: the same team connected to one shared
// system of record. Every label is a real fact from the engagement.
// Type floor: nothing under ~11.5 SVG units, so the smallest text still
// renders legibly after the 1600-unit canvas scales into the content column.
import DiagramDefs from './DiagramDefs.astro';
---

<figure class="fig" data-reveal>
  <figcaption class="fig-label">
    POOL PERMIT INTAKE · AS FOUND AND AS BUILT
  </figcaption>
  <div class="fig-hint" aria-hidden="true">SCROLL SIDEWAYS FOR THE FULL DIAGRAM &rarr;</div>
  <div class="fig-scroll">
    <svg
      viewBox="0 0 1600 700"
      role="img"
      aria-label="Before and after diagram: permit intake as found, four staff members exchanging email and separate copies with no shared system, and as built, the same team connected to one SharePoint list fed by one Microsoft Form and seven Power Automate flows."
      style="font-family: var(--font-sans); width: 100%; height: auto; display: block;"
    >
      <DiagramDefs prefix="pd" />

      <!-- registration marks, four corners -->
      <use href="#pd-reg" x="22" y="22" width="18" height="18" />
      <use href="#pd-reg" x="1560" y="22" width="18" height="18" />
      <use href="#pd-reg" x="22" y="660" width="18" height="18" />
      <use href="#pd-reg" x="1560" y="660" width="18" height="18" />

      <!-- ================= LEFT · AS FOUND ================= -->
      <g transform="rotate(-0.4 400 350)">
        <text x="60" y="70" font-size="18" font-weight="700" letter-spacing="2.2" fill="var(--ink)">AS FOUND</text>
        <text x="60" y="96" font-size="12.5" letter-spacing="1.6" fill="var(--grey-label)">DISCONNECTED COPIES · POINT-TO-POINT EMAIL</text>

        <!-- applicant -->
        <rect x="50" y="300" width="132" height="48" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
        <text x="116" y="329" font-size="13.5" font-weight="600" text-anchor="middle" fill="var(--ink)">APPLICANT</text>

        <!-- feeds into the department -->
        <path d="M184 312 Q 240 248 296 184" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
        <path d="M296 184 l-9 1 m9 -1 l-4 8" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
        <text x="206" y="250" font-size="12" letter-spacing="1.2" fill="var(--grey-label)" transform="rotate(-40 206 250)">EMAIL</text>
        <path d="M184 338 Q 240 396 296 428" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
        <path d="M296 428 l-9 -2 m9 2 l-6 7" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
        <text x="212" y="388" font-size="12" letter-spacing="1.2" fill="var(--grey-label)" transform="rotate(30 212 388)">PAPER</text>

        <!-- the mesh: everyone emails everyone -->
        <g fill="none" stroke="var(--ink)" stroke-width="0.85" opacity="0.55">
          <path d="M398 172 Q 505 168 592 200" />
          <path d="M356 182 Q 338 300 356 418" />
          <path d="M400 176 Q 520 300 608 420" />
          <path d="M598 226 Q 480 330 402 426" />
          <path d="M632 232 Q 662 325 632 418" />
          <path d="M432 446 Q 505 458 556 444" />
        </g>
        <text x="497" y="318" font-size="12" letter-spacing="1.6" text-anchor="middle" fill="var(--grey-label)">EVERYONE EMAILS EVERYONE</text>

        <!-- staff nodes -->
        <g>
          <rect x="292" y="138" width="146" height="44" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
          <text x="365" y="165" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">EPH MANAGER</text>
          <rect x="556" y="188" width="138" height="44" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
          <text x="625" y="215" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">INSPECTOR</text>
          <rect x="296" y="418" width="138" height="44" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
          <text x="365" y="445" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">ADMIN</text>
          <rect x="556" y="418" width="138" height="44" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
          <text x="625" y="445" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">INSPECTOR</text>
        </g>

        <!-- each person's own copy of the truth -->
        <g stroke="var(--ink-muted-4)" stroke-width="0.8" stroke-dasharray="2 3" fill="none">
          <path d="M330 182 L245 200" />
          <path d="M660 232 L668 254" />
          <path d="M330 462 L255 476" />
          <path d="M625 462 L620 482" />
        </g>
        <g>
          <g transform="rotate(-1 160 218)">
            <rect x="62" y="200" width="196" height="36" fill="var(--bone)" stroke="var(--ink-muted-4)" stroke-width="0.9" />
            <rect x="62" y="200" width="196" height="36" fill="url(#pd-ht)" />
            <text x="160" y="223" font-size="12" letter-spacing="0.8" text-anchor="middle" fill="var(--ink-muted-2)">EXCEL TRACKING COPY</text>
          </g>
          <g transform="rotate(1.2 660 272)">
            <rect x="582" y="254" width="156" height="36" fill="var(--bone)" stroke="var(--ink-muted-4)" stroke-width="0.9" />
            <rect x="582" y="254" width="156" height="36" fill="url(#pd-ht)" />
            <text x="660" y="277" font-size="12" letter-spacing="0.8" text-anchor="middle" fill="var(--ink-muted-2)">EMAIL THREADS</text>
          </g>
          <g transform="rotate(1 172 494)">
            <rect x="98" y="476" width="148" height="36" fill="var(--bone)" stroke="var(--ink-muted-4)" stroke-width="0.9" />
            <rect x="98" y="476" width="148" height="36" fill="url(#pd-ht)" />
            <text x="172" y="499" font-size="12" letter-spacing="0.8" text-anchor="middle" fill="var(--ink-muted-2)">PAPER FILES</text>
          </g>
          <g transform="rotate(-1.2 628 498)">
            <rect x="512" y="480" width="232" height="36" fill="var(--bone)" stroke="var(--ink-muted-4)" stroke-width="0.9" />
            <rect x="512" y="480" width="232" height="36" fill="url(#pd-ht)" />
            <text x="628" y="503" font-size="12" letter-spacing="0.8" text-anchor="middle" fill="var(--ink-muted-2)">LETTERS TYPED BY HAND</text>
          </g>
        </g>

        <!-- the chase loop -->
        <path d="M330 464 C 285 560, 140 560, 106 402" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" stroke-dasharray="5 5" />
        <path d="M106 402 l-4 9 m4 -9 l7 7" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
        <text x="88" y="580" font-size="12" letter-spacing="1.2" fill="var(--grey-label)">INCOMPLETE? CHASE THE APPLICANT, AGAIN</text>

        <text x="60" y="644" font-size="13.5" letter-spacing="1.4" fill="var(--ink-muted-4)">STATUS LIVES IN FOUR PLACES · NONE OF THEM AGREE</text>
      </g>

      <!-- ================= DIVIDER ================= -->
      <line x1="800" y1="70" x2="800" y2="640" stroke="var(--grey-faint)" stroke-width="1" stroke-dasharray="6 6" />
      <text x="814" y="322" font-size="13" font-weight="700" letter-spacing="3" fill="var(--accent)" transform="rotate(90 814 322)">REBUILT &rarr;</text>

      <!-- ================= RIGHT · AS BUILT ================= -->
      <g transform="rotate(0.3 1200 350)">
        <text x="860" y="70" font-size="18" font-weight="700" letter-spacing="2.2" fill="var(--accent)">AS BUILT</text>
        <text x="860" y="96" font-size="12.5" letter-spacing="1.6" fill="var(--grey-label)">ONE SHARED SYSTEM OF RECORD</text>

        <!-- applicant → form -->
        <rect x="846" y="126" width="132" height="48" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
        <text x="912" y="155" font-size="13.5" font-weight="600" text-anchor="middle" fill="var(--ink)">APPLICANT</text>
        <path d="M980 150 h30 m0 0 l-8 -5 m8 5 l-8 5" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />

        <!-- microsoft form, with misregistration echo; permit types fold into the caption -->
        <rect x="1018" y="112" width="240" height="76" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" transform="translate(3 -3)" />
        <rect x="1018" y="112" width="240" height="76" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.2" />
        <text x="1138" y="143" font-size="14.5" font-weight="700" text-anchor="middle" fill="var(--ink)">MICROSOFT FORM</text>
        <text x="1138" y="167" font-size="12.5" letter-spacing="0.9" text-anchor="middle" fill="var(--grey-label)">ONE INTAKE · FOUR PERMIT TYPES</text>

        <!-- form feeds the hub -->
        <path d="M1138 188 V 246" fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />
        <path d="M1138 246 l-5 -8 m5 8 l5 -8" fill="none" stroke="var(--ink-muted-4)" stroke-width="1" />

        <!-- migration annotation -->
        <text x="1000" y="228" font-size="12.5" letter-spacing="1" text-anchor="end" fill="var(--accent)">51 RECORDS MIGRATED IN</text>
        <path d="M1006 234 Q 1022 246 1038 258" fill="none" stroke="var(--accent)" stroke-width="0.9" />
        <path d="M1038 258 l-8 -1 m8 1 l-5 -7" fill="none" stroke="var(--accent)" stroke-width="0.9" />

        <!-- the hub: sharepoint list -->
        <rect x="993" y="253" width="300" height="96" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" transform="translate(3 -3)" />
        <rect x="993" y="253" width="300" height="96" fill="var(--bone)" stroke="var(--accent)" stroke-width="1.6" />
        <text x="1143" y="295" font-size="17" font-weight="700" text-anchor="middle" fill="var(--ink)">SHAREPOINT LIST</text>
        <text x="1143" y="322" font-size="12" letter-spacing="1.6" text-anchor="middle" fill="var(--accent)">ONE SHARED LIVE VIEW</text>

        <!-- same four people, now spokes to one hub -->
        <g fill="none" stroke="var(--ink)" stroke-width="0.85" opacity="0.75">
          <path d="M968 290 L991 296" />
          <path d="M968 344 L991 324" />
          <path d="M1318 290 L1295 296" />
          <path d="M1318 344 L1295 324" />
        </g>
        <g>
          <rect x="822" y="270" width="146" height="40" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
          <text x="895" y="295" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">EPH MANAGER</text>
          <rect x="822" y="326" width="146" height="40" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
          <text x="895" y="351" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">ADMIN</text>
          <rect x="1318" y="270" width="146" height="40" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
          <text x="1391" y="295" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">INSPECTOR</text>
          <rect x="1318" y="326" width="146" height="40" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
          <text x="1391" y="351" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">INSPECTOR</text>
        </g>

        <!-- the automation band: seven flows, one readable strip -->
        <path d="M1143 349 V 396" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
        <path d="M1143 396 l-5 -8 m5 8 l5 -8" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
        <rect x="900" y="398" width="600" height="74" fill="var(--bone)" stroke="var(--ink)" stroke-width="0.9" />
        <rect x="900" y="398" width="600" height="74" fill="url(#pd-ht)" opacity="0.5" />
        <text x="1200" y="428" font-size="13.5" font-weight="700" letter-spacing="1.6" text-anchor="middle" fill="var(--ink)">SEVEN POWER AUTOMATE FLOWS</text>
        <text x="1200" y="454" font-size="12.5" letter-spacing="0.9" text-anchor="middle" fill="var(--ink-muted-2)">CONFIRMATIONS · NOTIFICATIONS · 30-DAY CLOCK · REMINDERS · ENFORCEMENT</text>

        <text x="860" y="644" font-size="13.5" letter-spacing="1.4" fill="var(--ink-muted-4)">SAME TEAM · ONE LIVE VIEW · NOTHING SUBMITTED INCOMPLETE</text>
      </g>
    </svg>
  </div>
</figure>

<style>
  .fig { margin: 12vh 0 0; }
  .fig-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--grey-label);
    margin-bottom: 4vh;
  }
  .fig-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .fig-hint { display: none; }
  @media (max-width: 720px) {
    .fig-scroll svg { min-width: 1500px; }
    .fig-hint {
      display: block;
      margin-bottom: 2vh;
      font-family: var(--font-sans);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--grey-label);
    }
  }
</style>
