---
// Prospecting, before and after the Apollo rebuild.
// Two simple chains: the manual per-account loop the BDR verifies by hand,
// and the same path with the Apollo workflow doing the middle of it.
import DiagramDefs from './DiagramDefs.astro';
---

<figure class="fig" data-reveal>
  <figcaption class="fig-label">
    PROSPECTING AN ACCOUNT · AS FOUND AND AS BUILT
  </figcaption>
  <div class="fig-hint" aria-hidden="true">SCROLL SIDEWAYS FOR THE FULL DIAGRAM &rarr;</div>
  <div class="fig-scroll">
    <svg
      viewBox="0 0 1600 430"
      role="img"
      aria-label="Before and after diagram. As found: account in Salesforce, verify account, find contact on LinkedIn, verify contact, Outreach, send email, with the BDR manually checking and verifying every step at about ten minutes per account. As built: account in Salesforce, Apollo workflow, two to four quality contacts, Outreach, send email."
      style="font-family: var(--font-sans); width: 100%; height: auto; display: block;"
    >
      <DiagramDefs prefix="psd" />

      <use href="#psd-reg" x="22" y="22" width="18" height="18" />
      <use href="#psd-reg" x="1560" y="22" width="18" height="18" />
      <use href="#psd-reg" x="22" y="390" width="18" height="18" />
      <use href="#psd-reg" x="1560" y="390" width="18" height="18" />

      <!-- ============ AS FOUND · the manual chain ============ -->
      <g transform="rotate(-0.3 800 130)">
        <text x="60" y="62" font-size="13" font-weight="700" letter-spacing="2" fill="var(--ink)">AS FOUND</text>
        <text x="185" y="62" font-size="10.5" letter-spacing="1.6" fill="var(--grey-label)">EVERY ACCOUNT, BY HAND</text>

        {[
          { x: 60, t: 'ACCOUNT IN SALESFORCE' },
          { x: 312, t: 'VERIFY ACCOUNT' },
          { x: 564, t: 'FIND CONTACT', s: 'LINKEDIN' },
          { x: 816, t: 'VERIFY CONTACT' },
          { x: 1068, t: 'OUTREACH' },
          { x: 1320, t: 'SEND EMAIL' },
        ].map((b) => (
          <g>
            <rect x={b.x} y="90" width="220" height="60" fill="var(--bone)" stroke="var(--ink)" stroke-width="1.1" />
            <rect x={b.x} y="90" width="220" height="60" fill="url(#psd-ht)" opacity="0.4" />
            <text x={b.x + 110} y={b.s ? 116 : 125} font-size="11" font-weight="700" text-anchor="middle" fill="var(--ink)">{b.t}</text>
            {b.s && <text x={b.x + 110} y="134" font-size="9" letter-spacing="0.8" text-anchor="middle" fill="var(--grey-label)">{b.s}</text>}
          </g>
        ))}
        <g fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9">
          <path d="M280 120 h32 m0 0 l-8 -5 m8 5 l-8 5" />
          <path d="M532 120 h32 m0 0 l-8 -5 m8 5 l-8 5" />
          <path d="M784 120 h32 m0 0 l-8 -5 m8 5 l-8 5" />
          <path d="M1036 120 h32 m0 0 l-8 -5 m8 5 l-8 5" />
          <path d="M1288 120 h32 m0 0 l-8 -5 m8 5 l-8 5" />
        </g>

        <!-- bracket: the BDR verifies all of it, by hand -->
        <path d="M60 172 v10 h1480 v-10" fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9" />
        <text x="800" y="208" font-size="10.5" font-weight="600" letter-spacing="1.4" text-anchor="middle" fill="var(--ink-muted-2)">
          BDR MANUALLY CHECKS AND VERIFIES EVERY STEP · ~10 MIN PER ACCOUNT · REPEATED ALL DAY
        </text>
      </g>

      <!-- ============ divider ============ -->
      <line x1="60" y1="242" x2="1540" y2="242" stroke="var(--grey-faint)" stroke-width="1" stroke-dasharray="6 6" />
      <text x="1540" y="234" font-size="11" font-weight="700" letter-spacing="3" text-anchor="end" fill="var(--accent)">REBUILT &darr;</text>

      <!-- ============ AS BUILT · the Apollo chain ============ -->
      <g transform="rotate(0.3 800 320)">
        <text x="60" y="292" font-size="13" font-weight="700" letter-spacing="2" fill="var(--accent)">AS BUILT</text>
        <text x="170" y="292" font-size="10.5" letter-spacing="1.6" fill="var(--grey-label)">ONE AUTOMATED RUN</text>

        {[
          { x: 60, t: 'ACCOUNT IN SALESFORCE' },
          { x: 366, t: 'APOLLO WORKFLOW', s: 'AI QUALIFICATION · ENRICH · VALIDATE', accent: true },
          { x: 672, t: '2 TO 4 QUALITY CONTACTS', s: 'PER ACCOUNT', accent: true },
          { x: 978, t: 'OUTREACH' },
          { x: 1284, t: 'SEND EMAIL' },
        ].map((b) => (
          <g>
            {b.accent && (
              <rect x={b.x} y="316" width="256" height="60" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" transform="translate(3 -3)" />
            )}
            <rect x={b.x} y="316" width="256" height="60" fill="var(--bone)" stroke={b.accent ? 'var(--accent)' : 'var(--ink)'} stroke-width={b.accent ? '1.5' : '1.1'} />
            <text x={b.x + 128} y={b.s ? 342 : 351} font-size="11" font-weight="700" text-anchor="middle" fill="var(--ink)">{b.t}</text>
            {b.s && <text x={b.x + 128} y="360" font-size="8.5" letter-spacing="0.8" text-anchor="middle" fill={b.accent ? 'var(--accent)' : 'var(--grey-label)'}>{b.s}</text>}
          </g>
        ))}
        <g fill="none" stroke="var(--ink-muted-4)" stroke-width="0.9">
          <path d="M318 346 h44 m0 0 l-8 -5 m8 5 l-8 5" />
          <path d="M624 346 h44 m0 0 l-8 -5 m8 5 l-8 5" />
          <path d="M930 346 h44 m0 0 l-8 -5 m8 5 l-8 5" />
          <path d="M1236 346 h44 m0 0 l-8 -5 m8 5 l-8 5" />
        </g>
      </g>
    </svg>
  </div>
</figure>

<style>
  .fig { margin: 12vh 0 0; }
  .fig-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--grey-label);
    margin-bottom: 4vh;
  }
  .fig-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .fig-hint { display: none; }
  @media (max-width: 720px) {
    .fig-scroll svg { min-width: 1500px; }
    .fig-hint {
      display: block;
      margin-bottom: 2vh;
      font-family: var(--font-sans);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--grey-label);
    }
  }
</style>
