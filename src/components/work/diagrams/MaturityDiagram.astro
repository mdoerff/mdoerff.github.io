---
// The Noll engagement as an ascent: four layers of data maturity,
// each standing on the one below. Infrastructure at the base,
// intelligence at the top. Same visual family as the DOH figure.
import DiagramDefs from './DiagramDefs.astro';
---

<figure class="fig" data-reveal>
  <figcaption class="fig-label">
    THE FOUR-LAYER BUILD · EACH LAYER STANDS ON THE ONE BELOW
  </figcaption>
  <div class="fig-hint" aria-hidden="true">SCROLL SIDEWAYS FOR THE FULL DIAGRAM &rarr;</div>
  <div class="fig-scroll">
    <svg
      viewBox="0 0 1600 540"
      role="img"
      aria-label="Ascent diagram of the four-layer build. Steps rise from left to right: infrastructure (self-computing tracking, built for handoff), visibility (live Power BI, one view of the business), insight (revenue per connection, luxury analysis), and intelligence (LLM survey pipeline, coaching insight) at the top."
      style="font-family: var(--font-sans); width: 100%; height: auto; display: block;"
    >
      <DiagramDefs prefix="md" />

      <use href="#md-reg" x="22" y="22" width="18" height="18" />
      <use href="#md-reg" x="1560" y="22" width="18" height="18" />
      <use href="#md-reg" x="22" y="500" width="18" height="18" />
      <use href="#md-reg" x="1560" y="500" width="18" height="18" />

      <!-- the staircase: risers and treads -->
      <path
        d="M70 480 H 445 V 370 H 825 V 260 H 1205 V 150 H 1560"
        fill="none"
        stroke="var(--ink-muted-4)"
        stroke-width="1.1"
      />
      <!-- ground line -->
      <line x1="70" y1="480" x2="1560" y2="480" stroke="rgba(41,33,23,0.14)" stroke-width="1" />

      <!-- ascent arrow -->
      <path d="M170 435 Q 800 350 1380 118" fill="none" stroke="var(--accent)" stroke-width="1" stroke-dasharray="5 5" opacity="0.55" />
      <path d="M1380 118 l-10 1 m10 -1 l-5 9" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.7" />
      <text x="740" y="352" font-size="10.5" letter-spacing="2" fill="var(--accent)" transform="rotate(-11 740 352)">DATA MATURITY</text>

      {[
        {
          x: 95, y: 386, n: '01', name: 'INFRASTRUCTURE',
          s1: 'SELF-COMPUTING TRACKING', s2: 'CLEANED · BUILT FOR HANDOFF', accent: false,
        },
        {
          x: 475, y: 276, n: '02', name: 'VISIBILITY',
          s1: 'LIVE POWER BI SYSTEM', s2: 'ONE VIEW OF THE BUSINESS', accent: false,
        },
        {
          x: 855, y: 166, n: '03', name: 'INSIGHT',
          s1: 'REVENUE PER CONNECTION', s2: 'LUXURY SEGMENT ANALYSIS', accent: false,
        },
        {
          x: 1235, y: 56, n: '04', name: 'INTELLIGENCE',
          s1: 'LLM SURVEY PIPELINE', s2: 'PER-AGENT COACHING INSIGHT', accent: true,
        },
      ].map((b) => (
        <g>
          {b.accent && (
            <rect x={b.x} y={b.y} width="320" height="86" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.35" transform="translate(3 -3)" />
          )}
          <rect x={b.x} y={b.y} width="320" height="86" fill="var(--bone)" stroke={b.accent ? 'var(--accent)' : 'var(--ink)'} stroke-width={b.accent ? '1.6' : '1.2'} />
          <rect x={b.x} y={b.y} width="320" height="86" fill="url(#md-ht)" opacity="0.35" />
          <text x={b.x + 18} y={b.y + 30} font-size="12" font-weight="700" letter-spacing="1.6" fill={b.accent ? 'var(--accent)' : 'var(--ink)'}>
            <tspan fill="var(--accent)">{b.n}</tspan>
            <tspan dx="10">{b.name}</tspan>
          </text>
          <text x={b.x + 18} y={b.y + 52} font-size="9.5" letter-spacing="0.8" fill="var(--ink-muted-3)">{b.s1}</text>
          <text x={b.x + 18} y={b.y + 68} font-size="9.5" letter-spacing="0.8" fill="var(--grey-label)">{b.s2}</text>
        </g>
      ))}

      <text x="70" y="516" font-size="11" letter-spacing="1.4" fill="var(--ink-muted-4)">THE DATA WAS ALWAYS THERE · EACH LAYER MADE IT WORTH MORE</text>
    </svg>
  </div>
</figure>

<style>
  .fig { margin: 12vh 0 0; }
  .fig-label {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--grey-label);
    margin-bottom: 4vh;
  }
  .fig-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .fig-hint { display: none; }
  @media (max-width: 720px) {
    .fig-scroll svg { min-width: 1500px; }
    .fig-hint {
      display: block;
      margin-bottom: 2vh;
      font-family: var(--font-sans);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--grey-label);
    }
  }
</style>
