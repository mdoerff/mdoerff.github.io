---
// Result figures. Values are honest counts; the note carries labeled estimates.
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
  note?: string;
  disclaimer?: string;
}
const { stats, note, disclaimer } = Astro.props;
---

<div class="stats" data-reveal>
  <div class="stats-row">
    {stats.map((s) => (
      <div class="stat">
        <div class="stat-value">{s.value}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>
  {note && <p class="stats-note">{note}</p>}
  {disclaimer && <p class="stats-disclaimer">{disclaimer}</p>}
</div>

<style>
  .stats { margin-top: 6vh; }
  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 6vh 4vw;
  }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 4.8vw, 78px);
    line-height: 1;
    color: var(--ink);
  }
  .stat-label {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--grey-label);
    max-width: 230px;
    line-height: 1.6;
  }
  .stats-note {
    margin: 7vh 0 0;
    max-width: 640px;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.2vw, 17.5px);
    line-height: 1.65;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }
  .stats-disclaimer {
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--grey-faint);
  }
</style>
