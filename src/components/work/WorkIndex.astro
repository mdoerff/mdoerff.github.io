---
// Case Studies index — homepage section. Rows are named, never numbered.
// The rows come from src/data/cases.ts.
import { cases } from '../../data/cases';
---

<!-- The green chapter: fixed field that crossfades in as you scroll out of
     the hero. Lives here (homepage only) so case pages stay on cream paper. -->
<div class="green-field" id="green-field" aria-hidden="true"></div>

<section id="work" class="work" aria-label="Case studies">
  <div class="work-head" data-reveal>
    <h2 class="work-title">Case Studies</h2>
  </div>

  <div class="work-list">
    {cases.map((c) =>
      c.live ? (
        <a href={c.href} class="work-row" data-reveal>
          <div class="row-main">
            <h3 class="row-title">{c.title}</h3>
            <p class="row-desc">{c.desc}</p>
          </div>
          <div class="row-side">
            <span class="row-meta">{c.meta}</span>
            <span class="row-slip">READ THE CASE &rarr;</span>
          </div>
        </a>
      ) : (
        <div class="work-row row-off" data-reveal>
          <div class="row-main">
            <h3 class="row-title">{c.title}</h3>
            <p class="row-desc">{c.desc}</p>
          </div>
          <div class="row-side">
            <span class="row-meta">{c.meta}</span>
          </div>
        </div>
      )
    )}
  </div>
</section>

<script>
  // Scroll-driven chapter crossfades. The green field darkens in as the case
  // studies reach the viewport, then dissolves as the technical chapter
  // arrives, whose blueprint grid fades up in its place. One listener drives
  // both layers.
  function initChapterFields() {
    const field = document.getElementById('green-field');
    const work = document.getElementById('work');
    const tech = document.getElementById('technical');
    const grid = document.getElementById('blueprint-field');
    const tl = document.getElementById('timeline');
    const bone = document.getElementById('bone-field');
    const w = window as typeof window & { __gfUpdate?: () => void };
    if (w.__gfUpdate) {
      window.removeEventListener('scroll', w.__gfUpdate);
      window.removeEventListener('resize', w.__gfUpdate);
      w.__gfUpdate = undefined;
    }
    if (!field || !work) return;
    // Resolved once rather than per scroll event: this was the one DOM query
    // inside the handler, and it ran on every frame of every scroll to find
    // an element that never moves.
    const foot = document.querySelector('.foot');
    const smooth = (p: number) => p * p * (3 - 2 * p);
    const clamp = (p: number) => Math.min(1, Math.max(0, p));
    const apply = () => {
      const vh = window.innerHeight || 1;
      const pIn = smooth(clamp(1 - work.getBoundingClientRect().top / (vh * 0.85)));
      const pOut = tech ? smooth(clamp(1 - tech.getBoundingClientRect().top / (vh * 0.7))) : 0;
      const pTl = tl ? smooth(clamp(1 - tl.getBoundingClientRect().top / (vh * 0.7))) : 0;
      // The footer is shorter than a viewport, so its top can only travel
      // (footer height) px into view before the page ends: scale the fade
      // to the distance that actually exists, or it would never complete.
      let pFt = 0;
      if (foot) {
        const fr = foot.getBoundingClientRect();
        const runway = Math.min(vh * 0.7, fr.height * 0.85);
        pFt = smooth(clamp((vh - fr.top) / runway));
      }
      // Green carries the work chapter, hands off to bone+grid for technical,
      // RETURNS for the timeline, then dissolves out for the footer so the
      // page ends on the hero's own paper atmosphere: full circle.
      (field as HTMLElement).style.opacity = String(Math.min(1, pIn * (1 - pOut) + pTl) * (1 - pFt));
      if (grid) (grid as HTMLElement).style.opacity = String(pOut * (1 - pTl));
      if (bone) bone.style.opacity = String(pOut * (1 - pTl));
    };
    // Scroll events fire faster than the screen refreshes, especially during
    // a touch flick, and each pass here reads four layout rects — a forced
    // reflow — then writes to three full-viewport layers. Coalescing into one
    // rAF collapses that to at most one pass per painted frame, and lines the
    // writes up with the frame that will actually display them.
    let queued = false;
    const update = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        apply();
      });
    };
    w.__gfUpdate = update;
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    apply();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initChapterFields, { once: true });
  else initChapterFields();
</script>

<style>
  .green-field {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    will-change: opacity;
    background:
      radial-gradient(70% 55% at 50% 6%, rgba(82, 118, 98, 0.32), transparent 72%),
      radial-gradient(130% 130% at 50% 48%, transparent 55%, rgba(9, 17, 13, 0.4) 100%),
      #1F332A;
  }

  .work {
    position: relative;
    z-index: 2;
    padding: 14vh 4vw 12vh;
    scroll-margin-top: 4vh;
  }

  .work-head { margin-bottom: 8vh; }
  .work-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5.4vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--bone);
  }

  .work-list { display: flex; flex-direction: column; }

  .work-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4vw;
    padding: 5vh 2vw;
    transition: background 0.25s;
  }
  a.work-row:hover { background: rgba(233, 225, 207, 0.06); color: inherit; }
  a.work-row:hover .row-slip { color: #9DBFAA; border-bottom-color: #9DBFAA; }
  a.work-row:hover .row-title { color: #9DBFAA; }

  .row-main { max-width: 620px; }
  .row-title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.3vw, 32px);
    line-height: 1.15;
    color: var(--bone);
    transition: color 0.2s;
  }
  .row-desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    color: rgba(233, 225, 207, 0.72);
  }

  .row-side {
    display: flex;
    align-items: baseline;
    gap: 26px;
    flex-shrink: 0;
  }
  .row-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    /* 0.62 not 0.5: at 10px this is small text, and 0.5 lands at 3.77:1
       against the green, under the 4.5:1 WCAG AA floor. 0.62 gives 4.97. */
    color: rgba(233, 225, 207, 0.62);
    white-space: nowrap;
  }
  /* The same device the Technical section uses for VIEW THE DETAILS, set on the
     green ground. A bare arrow was the only cue that these rows led anywhere,
     and it was aria-hidden, so a screen reader got no hint at all and a touch
     user got no hover to discover it. Words are the cue now. */
  .row-slip {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgba(233, 225, 207, 0.75);
    white-space: nowrap;
    flex-shrink: 0;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(233, 225, 207, 0.4);
    transition: color 0.2s, border-color 0.2s;
  }

  .row-off { opacity: 0.4; }

  @media (max-width: 720px) {
    .work { padding: 10vh 6vw; }
    .work-head { margin-bottom: 5vh; }
    .work-row { flex-direction: column; gap: 14px; padding: 4vh 0; }
    .row-side { gap: 16px; }
    .row-meta { white-space: normal; letter-spacing: 0.12em; }
  }
</style>
