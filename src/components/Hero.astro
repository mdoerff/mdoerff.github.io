---
import portrait from '../assets/portrait.jpg';
---

<header id="top" class="hero" aria-label="Michael Doerffler — introduction">
  <div class="hero-field fx-develop">
    <!-- PORTRAIT, right. The fade (mask + cream edgefade) lives ON the photo box
         itself, so it travels with the photo and dissolves its edges the same way
         no matter the box's size or position — the blend is seamless on every
         screen. The box is sized by height (vh) with a fixed aspect ratio, so the
         framing (head-to-wrists) is identical across widescreen and narrow. -->
    <div class="portrait-wrap" aria-hidden="true">
      <div class="portrait-content">
        <div class="portrait-img">
          <img src={portrait.src} alt="" width={portrait.width} height={portrait.height} loading="eager" />
        </div>
        <div class="portrait-softlight"></div>
        <div class="portrait-edgefade"></div>
      </div>
    </div>

    <!-- MASTHEAD: text links set on a double rule, like a newspaper nameplate -->
    <div class="masthead fx-stamp">
      <div class="mh-row">
        <nav class="mh-nav" aria-label="Sections">
          <a href="#work" class="mh-link nav-active">Case Studies</a>
          <a href="/#technical" class="mh-link">Technical</a>
          <a href="/#timeline" class="mh-link">Timeline</a>
        </nav>
        <a href="mailto:michael@rmtdco.com" class="mh-cta"><span class="cta-full">Get in touch</span><span class="cta-short">Contact</span></a>
      </div>
      <div class="mh-rule" aria-hidden="true"></div>
    </div>

    <!-- orienting caption, upper-left — serif line + mono metadata -->
    <div class="hero-caption fx-stamp">
      <p class="caption-line">A few years of internships and projects have led me to the intersection of data, strategy, operations, and AI.</p>
      <div class="caption-meta">B.S. AI &amp; BUSINESS ANALYTICS · USF · DECEMBER 2026</div>
    </div>

    <!-- THE NAME — R · M · T · D read as one dark-green column → RMTDCO. -->
    <div class="nameplate fx-settle">
      <div class="nm nm-initial">R</div>
      <div class="nm nm-michael"><span class="nm-accent">M</span>ICHAEL</div>
      <div class="nm nm-initial">T</div>
      <div class="nm nm-doerffler"><span class="nm-accent">D</span>OERFFLER</div>
    </div>

  </div>
</header>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 580px;
    z-index: 1;
    color: var(--ink);
    overflow: hidden;
  }

  .hero-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* ---- Portrait: head-to-wrists, natural warm grade, soft dissolve ---- */
  .portrait-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Dissolve the WHOLE portrait stack (photo + softlight + edgefade fade
       together) at both ends: the top fade melts the photo's dark night sky
       into the atmosphere before it can mass into a black blob, and the
       bottom fade reaches transparent before the hero's overflow clip —
       otherwise the clip prints a hard line against the green field
       crossfading in behind the section below. */
    -webkit-mask-image: linear-gradient(180deg, transparent 2%, #000 26%, #000 70%, transparent 96%);
    mask-image: linear-gradient(180deg, transparent 2%, #000 26%, #000 70%, transparent 96%);
  }
  /* The photo box is sized by HEIGHT (vh) with a FIXED aspect ratio matching
     the photo (3:4), so cover shows the whole photo and the viewport crops the
     same fraction on every screen — the framing is identical on a widescreen
     laptop and a narrow window (the old vw-width + vh-height mix changed shape
     with the viewport's proportions, which is why it looked zoomed on 1920).
     It sits on the right, bled off the right edge and vertically centered. */
  .portrait-content {
    position: absolute;
    top: 50%;
    right: -6vw;
    transform: translateY(-50%);
    height: 130vh;
    aspect-ratio: 3 / 4;
    /* The fade lives HERE, on the box, in the box's own coordinates — so it
       dissolves the photo's edges the same way wherever the box lands. No
       viewport-anchored mask to drift out of alignment → no vertical-line seam. */
    -webkit-mask-image: radial-gradient(52% 86% at 55% 43%, #000 38%, rgba(0, 0, 0, 0.82) 56%, rgba(0, 0, 0, 0.3) 78%, transparent 95%);
    mask-image: radial-gradient(52% 86% at 55% 43%, #000 38%, rgba(0, 0, 0, 0.82) 56%, rgba(0, 0, 0, 0.3) 78%, transparent 95%);
  }
  /* Gentle lift so the dusk photo sits comfortably on the light page —
     keeps its real color so it ties into the blurred atmosphere behind it */
  .portrait-img {
    position: absolute;
    inset: 0;
    filter: saturate(0.92) contrast(0.98) brightness(1.28);
  }
  .portrait-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
  }
  .portrait-softlight {
    position: absolute; inset: 0; pointer-events: none;
    background: #E7DCC5; mix-blend-mode: soft-light; opacity: 0.45;
  }
  /* Cream echo of the mask (same shape), so the photo fades toward the page's
     own tone as its own pixels fade to transparent — one continuous dissolve.
     The top linear layer veils the photo's near-black night sky so it reads
     as dusk tone at every viewport shape instead of massing into a dark blob
     (which shape shows how much sky depends on the window's aspect ratio).
     No opaque bottom layer here: the wrap's bottom mask dissolves the whole
     stack before the hero's clip, and an opaque cream slab would print a
     hard edge against the green field darkening behind the next section. */
  .portrait-edgefade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(233, 225, 207, 0.62) 0%, rgba(233, 225, 207, 0.46) 26%, rgba(233, 225, 207, 0.2) 42%, transparent 58%),
      radial-gradient(52% 86% at 55% 43%, transparent 38%, transparent 56%, rgba(233, 225, 207, 0.32) 78%, var(--bone) 95%);
  }

  /* ---- Masthead: text links on a double rule, no dark slabs ---- */
  .masthead {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 6;
    padding: 12px 3vw 0;
    font-family: var(--font-sans);
  }
  .mh-row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-bottom: 8px;
  }
  /* Bare mark, no box: the type is the stamp */
  .mh-nav {
    flex: 1;
    display: flex;
    justify-content: flex-start;
    gap: 36px;
  }
  .mh-link {
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted-2);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .mh-link:hover { color: var(--ink); border-bottom-color: var(--accent); }
  .mh-link.nav-active { color: var(--ink); border-bottom-color: var(--accent); }
  .mh-cta {
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .mh-cta:hover { border-bottom-color: var(--accent); }
  .cta-short { display: none; }
  /* The double rule: two hairlines, newspaper nameplate style.
     Featherweight — the masthead should sit on the page, not press on it. */
  .mh-rule {
    border-top: 1px solid rgba(41, 33, 23, 0.6);
    border-bottom: 1px solid rgba(41, 33, 23, 0.3);
    height: 3px;
  }

  /* ---- Orienting caption (serif line + mono metadata) ----
     Hierarchy is scale + typeface only; no weight-based emphasis.
     Placement/scale = OPTION A (quiet upper-left caption).
     To switch: OPTION B -> { bottom: 47vh (drop top); width: min(40vw,460px);
       caption-line clamp(16px,1.35vw,20px); caption-meta margin-top 16px }.
     OPTION C -> { top: 14vh; width: min(46vw,560px);
       caption-line clamp(23px,2.3vw,33px)/line-height 1.3; caption-meta 11px, margin-top 22px }. */
  /* Offsets are % of the hero box (not vh): the hero has a min-height floor,
     so viewport units drift out of the box on short windows and elements
     collide. A px floor keeps the caption clear of the masthead. */
  .hero-caption {
    position: absolute;
    top: max(16%, 118px); left: 3vw;
    width: min(34vw, 400px);
    z-index: 4;
  }
  .caption-line {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.5vw, 23px);
    line-height: 1.42;
    color: var(--ink-muted-1);
    text-wrap: pretty;
  }
  .caption-meta {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--grey-label);
  }

  /* ---- Nameplate (reduced scale — supports, doesn't dominate) ---- */
  .nameplate {
    position: absolute;
    left: 3vw; bottom: 9%;
    z-index: 3;
    font-family: var(--font-display);
    transform-origin: 0% 100%;
  }
  .nm { white-space: nowrap; }
  .nm-initial { font-weight: 400; font-size: 2.3vw; line-height: 1.1; color: var(--accent); }
  .nm-michael {
    font-weight: 700; font-size: 4vw; line-height: 1.0; letter-spacing: -0.005em;
    color: var(--ink);
    text-shadow: 1.5px 1.5px 0 rgba(46, 74, 58, 0.16);
  }
  .nm-doerffler {
    font-weight: 700; font-size: 5.1vw; line-height: 0.98; letter-spacing: -0.01em;
    color: var(--ink);
    text-shadow: 1.5px 1.5px 0 rgba(46, 74, 58, 0.16);
  }
  .nm-accent { color: var(--accent); }

  /* ---- Short-but-wide desktop windows: keep the plate clear of the copy ---- */
  @media (min-width: 721px) and (max-height: 740px) {
    .nameplate { bottom: 7%; }
    .hero-caption { top: max(14%, 112px); }
  }

  /* ---- Mid widths: tighten the masthead so it stays on one line ---- */
  @media (max-width: 980px) {
    .mh-nav { gap: 22px; }
    .mh-row { gap: 16px; }
  }

  /* ---- Mobile: one row, no stamp, links spread edge to edge ---- */
  @media (max-width: 720px) {
    .masthead { padding: 10px 4.5vw 0; }
    .mh-row { padding-bottom: 8px; justify-content: space-between; gap: 0; }
    .mh-nav { flex: 0 1 auto; justify-content: flex-start; gap: 12px; }
    .mh-link { font-size: 10px; letter-spacing: 0.04em; padding: 8px 0 2px; }
    .mh-cta { font-size: 10px; letter-spacing: 0.04em; padding: 8px 0 2px; margin-left: 12px; }
    .cta-full { display: none; }
    .cta-short { display: inline; }
    .mh-rule { height: 2px; }
    .hero-caption { top: max(15%, 96px); left: 6vw; width: min(82vw, 440px); }
    .caption-line { font-size: 19px; }
    .nameplate { left: 6vw; bottom: 9%; }
    .nm-initial { font-size: 5vw; }
    .nm-michael { font-size: 9.5vw; }
    .nm-doerffler { font-size: 12vw; }
    /* on mobile the photo is full-bleed behind the text, not the right-side
       portrait column used on desktop — reset the box and its mask to cover */
    .portrait-content {
      inset: 0;
      top: 0; right: 0;
      width: auto; height: auto;
      aspect-ratio: auto;
      transform: none;
      -webkit-mask-image: radial-gradient(70% 62% at 60% 40%, #000 0%, rgba(0, 0, 0, 0.9) 22%, rgba(0, 0, 0, 0.55) 40%, rgba(0, 0, 0, 0.15) 58%, transparent 74%);
      mask-image: radial-gradient(70% 62% at 60% 40%, #000 0%, rgba(0, 0, 0, 0.9) 22%, rgba(0, 0, 0, 0.55) 40%, rgba(0, 0, 0, 0.15) 58%, transparent 74%);
    }
    .portrait-img img { object-position: 50% 24%; }
    /* layer an extra top fade over the radial dissolve so the caption stays
       legible: the veil runs deep enough to cover the caption zone at ANY
       mobile width, clearing before the face in the photo's lower middle */
    .portrait-edgefade {
      background:
        linear-gradient(180deg, rgba(233, 225, 207, 0.94) 0%, rgba(233, 225, 207, 0.85) 35%, rgba(233, 225, 207, 0.45) 55%, transparent 72%),
        radial-gradient(70% 62% at 60% 40%, transparent 0%, transparent 22%, rgba(233, 225, 207, 0.3) 40%, rgba(233, 225, 207, 0.75) 58%, var(--bone) 74%);
    }
  }

  /* ---- Narrowest phones: keep the single nav row alive ---- */
  @media (max-width: 374px) {
    .mh-nav { gap: 8px; }
    .mh-link, .mh-cta { letter-spacing: 0; }
    .mh-cta { margin-left: 8px; }
  }

  /* ---- Wide-short "mobile" windows (zoomed desktops, split screens):
     the phone crop assumptions break — the full-bleed mask would expose the
     photo's whole sky behind the text. Tighten the window onto the face. ---- */
  @media (min-width: 501px) and (max-width: 720px) {
    .portrait-content {
      -webkit-mask-image: radial-gradient(46% 52% at 62% 58%, #000 0%, rgba(0, 0, 0, 0.9) 26%, rgba(0, 0, 0, 0.5) 46%, rgba(0, 0, 0, 0.12) 62%, transparent 76%);
      mask-image: radial-gradient(46% 52% at 62% 58%, #000 0%, rgba(0, 0, 0, 0.9) 26%, rgba(0, 0, 0, 0.5) 46%, rgba(0, 0, 0, 0.12) 62%, transparent 76%);
    }
    .portrait-img img { object-position: 50% 34%; }
    .portrait-edgefade {
      background:
        linear-gradient(180deg, rgba(233, 225, 207, 0.94) 0%, rgba(233, 225, 207, 0.85) 38%, rgba(233, 225, 207, 0.4) 56%, transparent 72%),
        radial-gradient(46% 52% at 62% 58%, transparent 0%, transparent 26%, rgba(233, 225, 207, 0.35) 46%, rgba(233, 225, 207, 0.8) 62%, var(--bone) 76%);
    }
  }
</style>
