---
import portrait from '../assets/portrait.jpg';
---

<header id="top" class="hero" aria-label="Michael Doerffler — introduction">
  <div class="hero-field fx-develop">
    <!-- PORTRAIT, right. The fade (mask + cream edgefade) lives ON the photo box
         itself, so it travels with the photo and dissolves its edges the same way
         no matter the box's size or position — the blend is seamless on every
         screen. The box is sized by height (vh) with a fixed aspect ratio, so the
         framing (head-to-wrists) is identical across widescreen and narrow. -->
    <div class="portrait-wrap" aria-hidden="true">
      <div class="portrait-content">
        <div class="portrait-img">
          <img src={portrait.src} alt="" width={portrait.width} height={portrait.height} loading="eager" />
        </div>
        <div class="portrait-softlight"></div>
        <div class="portrait-edgefade"></div>
      </div>
    </div>

    <!-- TOP BAR -->
    <div class="topbar fx-stamp">
      <div class="topbar-brand">
        <span class="monogram">RMTD</span>
      </div>
      <nav class="topbar-nav" aria-label="Sections">
        <a href="#work" class="nav-active">Case Studies</a>
        <a href="/#technical" class="nav-mid">Technical</a>
        <a href="/#timeline" class="nav-end">Timeline</a>
      </nav>
      <div class="topbar-right">
        <a href="mailto:michael@rmtdco.com" class="cta">GET IN TOUCH</a>
      </div>
    </div>

    <!-- orienting caption, upper-left — serif line + mono metadata -->
    <div class="hero-caption fx-stamp">
      <p class="caption-line">A few years of internships and projects have led me to the intersection of data, strategy, operations, and AI.</p>
      <div class="caption-meta">B.S. AI &amp; BUSINESS ANALYTICS · USF · DECEMBER 2026</div>
    </div>

    <!-- THE NAME — R · M · T · D read as one dark-green column → RMTDCO. -->
    <div class="nameplate fx-settle">
      <div class="nm nm-initial">R</div>
      <div class="nm nm-michael"><span class="nm-accent">M</span>ICHAEL</div>
      <div class="nm nm-initial">T</div>
      <div class="nm nm-doerffler"><span class="nm-accent">D</span>OERFFLER</div>
    </div>

  </div>
</header>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 520px;
    z-index: 1;
    color: var(--ink);
    overflow: hidden;
  }

  .hero-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* ---- Portrait: head-to-wrists, natural warm grade, soft dissolve ---- */
  .portrait-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* The photo box is sized by HEIGHT (vh) with a FIXED aspect ratio matching
     the photo (3:4), so cover shows the whole photo and the viewport crops the
     same fraction on every screen — the framing is identical on a widescreen
     laptop and a narrow window (the old vw-width + vh-height mix changed shape
     with the viewport's proportions, which is why it looked zoomed on 1920).
     It sits on the right, bled off the right edge and vertically centered. */
  .portrait-content {
    position: absolute;
    top: 50%;
    right: -6vw;
    transform: translateY(-50%);
    height: 130vh;
    aspect-ratio: 3 / 4;
    /* The fade lives HERE, on the box, in the box's own coordinates — so it
       dissolves the photo's edges the same way wherever the box lands. No
       viewport-anchored mask to drift out of alignment → no vertical-line seam. */
    -webkit-mask-image: radial-gradient(52% 86% at 55% 43%, #000 38%, rgba(0, 0, 0, 0.82) 56%, rgba(0, 0, 0, 0.3) 78%, transparent 95%);
    mask-image: radial-gradient(52% 86% at 55% 43%, #000 38%, rgba(0, 0, 0, 0.82) 56%, rgba(0, 0, 0, 0.3) 78%, transparent 95%);
  }
  /* Gentle lift so the dusk photo sits comfortably on the light page —
     keeps its real color so it ties into the blurred atmosphere behind it */
  .portrait-img {
    position: absolute;
    inset: 0;
    filter: saturate(0.92) contrast(0.98) brightness(1.28);
  }
  .portrait-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
  }
  .portrait-softlight {
    position: absolute; inset: 0; pointer-events: none;
    background: #E7DCC5; mix-blend-mode: soft-light; opacity: 0.45;
  }
  /* Cream echo of the mask (same shape), so the photo fades toward the page's
     own tone as its own pixels fade to transparent — one continuous dissolve.
     The extra bottom linear layer settles the photo into bone BEFORE the
     hero's bottom edge, so scrolling into the next section never slices it. */
  .portrait-edgefade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, transparent 70%, var(--bone) 86%),
      radial-gradient(52% 86% at 55% 43%, transparent 38%, transparent 56%, rgba(233, 225, 207, 0.32) 78%, var(--bone) 95%);
  }

  /* ---- Top bar (Inter, readable sizes, strong contrast) ---- */
  .topbar {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 6;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 3vw;
    font-family: var(--font-sans);
  }
  .topbar-brand { display: flex; align-items: center; gap: 12px; }
  .monogram {
    display: inline-flex; align-items: center; justify-content: center;
    height: 26px;
    padding: 0 8px;
    border: 1px solid rgba(41, 33, 23, 0.42);
    font-size: 10px; font-weight: 600; letter-spacing: 0.06em;
    color: var(--ink);
  }
  /* The nav sits on its own ink bar, same style as the GET IN TOUCH button,
     with the tonal gradient running across the three labels. */
  .topbar-nav {
    display: flex;
    gap: 30px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--ink);
    padding: 8px 18px;
  }
  .topbar-nav a { font-weight: 600; color: #C9C3B4; transition: color 0.15s; }
  .topbar-nav a:hover { color: var(--bone); }
  .topbar-nav .nav-active { color: #C9C3B4; font-weight: 600; }
  .topbar-nav .nav-mid { color: #B1AB9C; }
  .topbar-nav .nav-end { color: #9B9484; }
  .topbar-right { display: flex; align-items: center; gap: 20px; font-size: 11px; letter-spacing: 0.1em; }
  .cta {
    color: var(--bone);
    background: var(--ink);
    padding: 8px 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .cta:hover { background: var(--accent); color: var(--bone); }

  /* ---- Orienting caption (serif line + mono metadata) ----
     Hierarchy is scale + typeface only; no weight-based emphasis.
     Placement/scale = OPTION A (quiet upper-left caption).
     To switch: OPTION B -> { bottom: 47vh (drop top); width: min(40vw,460px);
       caption-line clamp(16px,1.35vw,20px); caption-meta margin-top 16px }.
     OPTION C -> { top: 14vh; width: min(46vw,560px);
       caption-line clamp(23px,2.3vw,33px)/line-height 1.3; caption-meta 11px, margin-top 22px }. */
  .hero-caption {
    position: absolute;
    top: 15vh; left: 3vw;
    width: min(34vw, 400px);
    z-index: 4;
  }
  .caption-line {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.5vw, 23px);
    line-height: 1.42;
    color: var(--ink-muted-1);
    text-wrap: pretty;
  }
  .caption-meta {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--grey-label);
  }

  /* ---- Nameplate (reduced scale — supports, doesn't dominate) ---- */
  .nameplate {
    position: absolute;
    left: 3vw; bottom: 9vh;
    z-index: 3;
    font-family: var(--font-display);
    transform-origin: 0% 100%;
  }
  .nm { white-space: nowrap; }
  .nm-initial { font-weight: 400; font-size: 2.3vw; line-height: 1.1; color: var(--accent); }
  .nm-michael {
    font-weight: 700; font-size: 4vw; line-height: 1.0; letter-spacing: -0.005em;
    color: var(--ink);
    text-shadow: 1.5px 1.5px 0 rgba(46, 74, 58, 0.16);
  }
  .nm-doerffler {
    font-weight: 700; font-size: 5.1vw; line-height: 0.98; letter-spacing: -0.01em;
    color: var(--ink);
    text-shadow: 1.5px 1.5px 0 rgba(46, 74, 58, 0.16);
  }
  .nm-accent { color: var(--accent); }

  /* ---- Short-but-wide desktop windows: keep the plate clear of the copy ---- */
  @media (min-width: 721px) and (max-height: 740px) {
    .nameplate { bottom: 7vh; }
    .hero-caption { top: 13vh; }
  }

  /* ---- Mid widths: keep the top bar on one line ---- */
  @media (max-width: 980px) {
    .topbar-nav { gap: 18px; }
  }

  /* ---- Mobile ---- */
  @media (max-width: 720px) {
    .topbar { padding: 14px 6vw; }
    .topbar-nav { display: none; }
    .hero-caption { top: 14vh; left: 6vw; width: min(82vw, 440px); }
    .caption-line { font-size: 19px; }
    .nameplate { left: 6vw; bottom: 9vh; }
    .nm-initial { font-size: 5vw; }
    .nm-michael { font-size: 9.5vw; }
    .nm-doerffler { font-size: 12vw; }
    /* on mobile the photo is full-bleed behind the text, not the right-side
       portrait column used on desktop — reset the box and its mask to cover */
    .portrait-content {
      inset: 0;
      top: 0; right: 0;
      width: auto; height: auto;
      aspect-ratio: auto;
      transform: none;
      -webkit-mask-image: radial-gradient(70% 62% at 60% 40%, #000 0%, rgba(0, 0, 0, 0.9) 22%, rgba(0, 0, 0, 0.55) 40%, rgba(0, 0, 0, 0.15) 58%, transparent 74%);
      mask-image: radial-gradient(70% 62% at 60% 40%, #000 0%, rgba(0, 0, 0, 0.9) 22%, rgba(0, 0, 0, 0.55) 40%, rgba(0, 0, 0, 0.15) 58%, transparent 74%);
    }
    .portrait-img img { object-position: 50% 24%; }
    /* layer an extra top fade over the radial dissolve so the caption stays legible */
    .portrait-edgefade {
      background:
        linear-gradient(180deg, rgba(233, 225, 207, 0.92) 0%, transparent 30%),
        radial-gradient(70% 62% at 60% 40%, transparent 0%, transparent 22%, rgba(233, 225, 207, 0.3) 40%, rgba(233, 225, 207, 0.75) 58%, var(--bone) 74%);
    }
  }
</style>
