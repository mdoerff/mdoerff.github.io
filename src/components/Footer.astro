---
import { EMAIL } from '../data/site';

// Site-wide close, full circle: on the homepage the green field dissolves
// away as the footer arrives (the hero-to-work transition run backward),
// leaving the footer on the hero's own paper atmosphere. Far left, the
// RMTD column in the nameplate's green; beside it, the three contact
// links. No name repetition anywhere.
---

<footer id="contact" class="foot" aria-label="Contact and site footer">
  <div class="foot-inner">
    <!-- The one thing the site never said. A visitor who reaches the footer is
         already convinced by the work; this tells them what to do about it,
         and answers the question every recruiter asks second. Sits above the
         contact row rather than inside it, so the mark and links keep their
         layout untouched. -->
    <p class="foot-seeking" data-reveal>
      Graduating December 2026.
      <span class="foot-seeking-key">Looking for full-time work at the intersection of
      technology, data, and operations.</span>
    </p>

    <div class="foot-main" data-reveal>
      <div class="foot-mark" aria-hidden="true">
        <span>R</span><span>M</span><span>T</span><span>D</span>
      </div>

      <div class="foot-links">
        <a href={`mailto:${EMAIL}`} class="fl">
          <svg class="fl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="1.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
          <span>{EMAIL}</span>
        </a>
        <a href="https://www.linkedin.com/in/michael-doerffler" target="_blank" rel="noopener" class="fl">
          <svg class="fl-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
          <span>Connect with me</span>
        </a>
        <a href="https://www.youtube.com/watch?v=o-IO1-alcuw" target="_blank" rel="noopener" class="fl">
          <svg class="fl-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg>
          <span>Check out my podcast episode with Brad Noll, CEO of The Noll Team</span>
        </a>
      </div>
    </div>

    <div class="foot-imprint">
      <nav class="foot-nav" aria-label="Sections">
        <span class="foot-nav-label" aria-hidden="true">RETURN TO</span>
        <a href="/#work">Case Studies <span class="nav-up">&uarr;</span></a>
        <a href="/#technical">Technical <span class="nav-up">&uarr;</span></a>
        <a href="/#timeline">Timeline <span class="nav-up">&uarr;</span></a>
      </nav>
      <span class="foot-fine">&copy; 2026 Michael Doerffler</span>
    </div>
  </div>
</footer>

<style>
  /* Transparent ground: the footer sits directly on the page's fixed
     atmosphere layers (photo blur + cream veil + paper tooth), exactly the
     world the hero opens on. On the homepage the green field scroll-fades
     to zero beneath it; case pages are already on this paper. */
  .foot {
    position: relative;
    z-index: 2;
    padding: 18vh 4vw 26px;
  }

  .foot-seeking {
    margin: 0 0 6vh;
    max-width: 760px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(17px, 1.5vw, 23px);
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }
  .foot-seeking-key { color: var(--accent); }

  .foot-main {
    display: flex;
    align-items: center;
    gap: clamp(38px, 5vw, 96px);
  }

  /* The mark: the nameplate's letters come home, stacked, in the green */
  .foot-mark {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 58px);
    line-height: 1.04;
    color: var(--accent);
    text-shadow: 1px 1px 0 rgba(46, 74, 58, 0.14);
  }

  /* The links claim the rest of the line: stacked on mid screens, spread
     as three columns across the full width on large ones so the footer
     fills the viewport instead of huddling left. */
  .foot-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* 22px rather than 16 so each link's tap overlay clears the 44px guideline
       without adjacent zones colliding and stealing each other's taps. The
       links render 23.8px tall, so a 20px gap landed at 43.8. */
    gap: 22px;
    min-width: 0;
    flex: 1;
  }
  @media (min-width: 1100px) {
    .foot-links {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: clamp(28px, 3vw, 60px);
    }
    .fl { max-width: 30vw; }
  }
  .fl {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.4;
    color: var(--ink);
    transition: color 0.15s;
  }
  .fl:hover { color: var(--accent); }
  .fl-icon {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    color: var(--accent);
  }
  .fl span { border-bottom: 1px solid rgba(46, 74, 58, 0.35); padding-bottom: 2px; transition: border-color 0.15s; }
  .fl:hover span { border-bottom-color: var(--accent); }

  .foot-imprint {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 18px;
    margin-top: 7vh;
    border-top: 1px solid rgba(41, 33, 23, 0.18);
    padding-top: 12px;
  }
  .foot-nav { display: flex; align-items: baseline; gap: 24px; }

  /* Thumb targets, layout untouched. The nav links render ~16px tall and the
     contact links ~24px. Insets are capped by the gaps between them (18px in
     the nav, 16px in the contact column) so no two targets ever overlap. */
  .foot-nav a, .fl { position: relative; }
  .foot-nav a::after {
    content: '';
    position: absolute;
    inset: -15px -6px;
  }
  .fl::after {
    content: '';
    position: absolute;
    inset: -11px -6px;
  }
  /* Quiet frame word: marks the three links as destinations, not labels */
  .foot-nav-label {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--grey-label);
    margin-right: 8px;
  }
  .foot-nav a {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted-2);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  /* The case pages' own return device (BACK TO CASE STUDIES with an up
     arrow), reused here so on-page jumps read the same site-wide */
  .nav-up { color: var(--accent); }
  .foot-nav a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .foot-fine {
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--grey-label);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .foot { padding: 14vh 6vw 22px; }
    .foot-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 26px;
    }
    .foot-mark {
      flex-direction: row;
      gap: 6px;
      font-size: 28px;
    }
    .foot-imprint { flex-wrap: wrap; gap: 12px; }
    .foot-nav { gap: 18px; flex-wrap: wrap; }
  }
</style>
