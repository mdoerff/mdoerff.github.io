---
// Site-wide footer: a quiet contact band over the small-print row.
// Same print language as the masthead — hairlines and type, no slabs.
---

<footer class="foot" aria-label="Contact and site footer">
  <div class="foot-inner">
    <div class="foot-contact" data-reveal>
      <div class="sec-label">CONTACT</div>
      <p class="foot-line">Have a role or a project in mind?</p>
      <a href="mailto:michael@rmtdco.com" class="foot-mail">michael@rmtdco.com</a>
    </div>

    <div class="foot-rule" aria-hidden="true"></div>

    <div class="foot-row">
      <span class="foot-monogram">RMTD</span>
      <nav class="foot-nav" aria-label="Sections">
        <a href="/#work">Case Studies</a>
        <a href="/#technical">Technical</a>
        <a href="/#timeline">Timeline</a>
      </nav>
      <span class="foot-fine">&copy; 2026 Michael Doerffler &middot; Tampa, FL</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 2;
    padding: 10vh 4vw 26px;
  }
  .foot-inner { max-width: 1150px; }

  .foot-contact { margin-bottom: 7vh; }
  .foot-line {
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.3;
    color: var(--ink-muted-1);
  }
  .foot-mail {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 2.6vw, 36px);
    letter-spacing: -0.01em;
    color: var(--ink);
    border-bottom: 2px solid var(--accent);
    padding-bottom: 3px;
    transition: color 0.15s;
  }
  .foot-mail:hover { color: var(--accent); }

  .foot-rule {
    border-top: 2px solid rgba(41, 33, 23, 0.78);
    border-bottom: 1px solid rgba(41, 33, 23, 0.45);
    height: 2px;
  }

  .foot-row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 14px;
    font-family: var(--font-sans);
  }
  .foot-monogram {
    display: inline-flex; align-items: center; justify-content: center;
    height: 24px;
    padding: 0 7px;
    border: 1px solid rgba(41, 33, 23, 0.42);
    font-size: 10px; font-weight: 600; letter-spacing: 0.06em;
    color: var(--ink);
    flex-shrink: 0;
  }
  .foot-nav {
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 30px;
  }
  .foot-nav a {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted-2);
    transition: color 0.15s;
  }
  .foot-nav a:hover { color: var(--accent); }
  .foot-fine {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--grey-label);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .foot { padding: 8vh 6vw 22px; }
    .foot-row { flex-wrap: wrap; gap: 14px; justify-content: space-between; }
    .foot-nav { order: 3; flex-basis: 100%; justify-content: flex-start; gap: 22px; }
    .foot-fine { white-space: normal; }
  }
</style>
