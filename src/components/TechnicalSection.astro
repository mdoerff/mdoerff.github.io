      </div>
    </div>
  </dialog>
))}

<script>
  // Modal architecture: openers carry data-dialog, dialogs carry data-hash.
  // Deep-linkable (#3rivers etc.), back-button closes, backdrop/ESC/✕ close.
  function initTechnical() {
    const dialogs = new Map<string, HTMLDialogElement>(
      [...document.querySelectorAll<HTMLDialogElement>('dialog[data-hash]')].map((d) => [d.dataset.hash!, d])
    );
    if (!dialogs.size) return;
    let open: HTMLDialogElement | null = null;

    const openDlg = (hash: string, push: boolean) => {
      const d = dialogs.get(hash);
      if (!d || d.open) return;
      if (open) open.close();
      d.showModal();
      document.body.style.overflow = 'hidden';
      open = d;
      if (push) history.pushState({ dlg: hash }, '', '#' + hash);
      requestAnimationFrame(() =>
        d.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'))
      );
    };

    dialogs.forEach((d, hash) => {
      d.addEventListener('close', () => {
        document.body.style.overflow = '';
        d.querySelectorAll('[data-reveal]').forEach((el) => el.classList.remove('is-visible'));
        if (open === d) open = null;
        if (location.hash === '#' + hash) history.replaceState(null, '', '#technical');
      });
      d.addEventListener('click', (e) => {
        if (e.target === d) d.close();
      });
      d.querySelector('[data-close]')?.addEventListener('click', () => d.close());
    });

    document.querySelectorAll<HTMLElement>('[data-dialog]').forEach((btn) => {
      btn.addEventListener('click', () => openDlg(btn.dataset.dialog!, true));
    });

    window.addEventListener('popstate', () => {
      const h = location.hash.slice(1);
      if (dialogs.has(h)) openDlg(h, false);
      else if (open) open.close();
    });

    const initial = location.hash.slice(1);
    if (dialogs.has(initial)) setTimeout(() => openDlg(initial, false), 350);
  }
  document.addEventListener('astro:page-load', initTechnical);
</script>

<style>
