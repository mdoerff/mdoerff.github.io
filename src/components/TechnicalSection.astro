<!-- ============ PROJECT MODALS ============ -->
{projects.map((p) => (
  <dialog class="dlg dlg-proj-modal" data-hash={p.hash} aria-label={p.title}>
    <div class="dlg-inner">
      <span class="cm cm-tl" aria-hidden="true"></span><span class="cm cm-tr" aria-hidden="true"></span>
