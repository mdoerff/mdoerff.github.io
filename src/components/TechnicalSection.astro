---
// Technical: the homepage's third chapter. One screen of surface (a featured
// 3Rivers dossier card, three coursework cards, a slim toolkit strip); the
// depth lives in <dialog> overlays. The blueprint grid layer fades in as the
// green Case Studies chapter fades out (driven by WorkIndex's scroll handler).
// The projects themselves now live at /technical/<slug>. This section is their
// index; the content is shared so the two can never drift apart.
import { projects, featured } from '../data/technical';

// The skill stream: the whole technical profile in motion. Four lanes of
// tools (serif), each pulling its own techniques (chips) along with it, so
// the tool-to-technique relationship is visible without reading a caption.
// Each lane's content is duplicated for a seamless loop.
const lanes = [
  {
    dur: 62, reverse: false,
    clusters: [
      { tool: 'Power BI', chips: ['STAR SCHEMA', 'DAX · SUMX / RELATED', 'INTERACTIVE DASHBOARDS'] },
      { tool: 'Power Query', chips: ['ETL', 'MULTI-SOURCE JOINS', 'SCHEMA NORMALIZATION'] },
      { tool: 'Excel', chips: ['PIVOT TABLES', 'DATA CLEANING'] },
    ],
  },
  {
    dur: 78, reverse: true,
    clusters: [
      { tool: 'Python', chips: ['KMEANS CLUSTERING', 'MODEL EVALUATION', 'EDA'] },
      { tool: 'SQL', chips: ['WINDOW FUNCTIONS', 'NORMALIZED SCHEMA DESIGN'] },
      { tool: 'R', chips: ['STATISTICAL PROGRAMMING', 'DATA MIGRATION', 'CROSSWALK JOINS'] },
    ],
  },
  {
    dur: 56, reverse: false,
    clusters: [
      { tool: 'LLM pipelines', chips: ['PROMPT ENGINEERING', 'BATCH PROCESSING', 'SENTIMENT ANALYSIS'] },
      { tool: 'Claude Code', chips: ['AGENTIC WORKFLOWS'] },
      { tool: 'Power Automate', chips: ['CONDITIONAL AUTOMATION', 'NULL-CHECK GUARDS'] },
      { tool: 'Sheets', chips: ['SHEETS AUTOMATION', 'FORMULA-DRIVEN SYSTEMS'] },
    ],
  },
  {
    dur: 70, reverse: true,
    clusters: [
      { tool: 'Salesforce', chips: ['DASHBOARD DESIGN', 'SLICERS + CROSS-FILTERING'] },
      { tool: 'Outreach', chips: ['SOP DOCUMENTATION'] },
      { tool: 'Apollo', chips: [] },
      { tool: 'Notion systems', chips: [] },
      { tool: 'Web', chips: ['HTML + CSS', 'GITHUB PAGES', 'DNS CONFIGURATION'] },
    ],
  },
];
---

<!-- Opaque bone ground: fades in with the technical chapter and stays put
     for the timeline below, so both read as clean paper instead of the
     photographic atmosphere. The drafting grid rides on top of it. -->
<div class="bone-field" id="bone-field" aria-hidden="true"></div>
<div class="blueprint-field" id="blueprint-field" aria-hidden="true"></div>

<section id="technical" class="tech" aria-label="Technical">
  <div class="tech-head" data-reveal>
    <div class="sec-label">FEATURED TECHNICAL PROJECTS</div>
    <h2 class="tech-title">The machinery <span class="tech-title-2">behind the case studies.</span></h2>
    <p class="tech-intro">
      The case studies are where all of it came together: recent, real engagements that drew on
      everything built up before them. This section gives a bit of depth into that foundation:
      the data engineering, modeling, and analysis underneath the client work.
    </p>
  </div>

  <div class="featured" data-reveal>
    <a class="feat-hero" href={`/technical/${featured.slug}/`}>
      <span class="fh-body">
        <span class="fr-chip">{featured.tag}</span>
        <span class="fh-title">{featured.title}</span>
        <span class="fh-desc">{featured.blurb}</span>
      </span>
      <span class="fr-slip">VIEW THE DETAILS &rarr;</span>
    </a>

    <div class="feat-cols">
      {projects.map((p) => (
        <a class="feat-col" href={`/technical/${p.slug}/`}>
          <span class="fr-chip">{p.tag}</span>
          <span class="fc-title">{p.title}</span>
          <span class="fr-slip">+ EXPAND</span>
        </a>
      ))}
    </div>
  </div>

  <div class="tk-label" data-reveal>THE SKILL SET, IN MOTION</div>
  <div class="stream" data-reveal role="img" aria-label="A continuous flowing stream of technical skills: Power BI, Power Query, DAX, star schemas, ETL, pivot tables, Python, SQL, R, machine learning, LLM pipelines, Claude Code, Power Automate, Salesforce, Outreach, Apollo, and web deployment.">
    {lanes.map((lane) => (
      <div class={`lane ${lane.reverse ? 'lane-rev' : ''}`} style={`--dur: ${lane.dur}s;`} aria-hidden="true">
        <div class="lane-inner">
          {[0, 1].map(() => (
            lane.clusters.map((c) => (
              <span class="sk-cluster">
                <span class="sk-major">{c.tool}</span>
                {c.chips.map((chip) => <span class="sk-chip">{chip}</span>)}
              </span>
            ))
          ))}
        </div>
      </div>
    ))}
  </div>
  <p class="stream-note" data-reveal>
    Each tool moves with the techniques underneath it: Power Query pulling ETL and schema
    normalization, Python pulling clustering and model evaluation, and so on across what I've
    used in classes, internships, and personal projects. Rest on the stream to pause it.
  </p>
</section>


<style>
  .bone-field {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    will-change: opacity;
    background: var(--bone);
  }

  /* Blueprint chapter field: fades in via WorkIndex's scroll handler */
  .blueprint-field {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    will-change: opacity;
    background-image:
      linear-gradient(rgba(41, 33, 23, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(41, 33, 23, 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
  }

  .tech {
    position: relative;
    z-index: 2;
    padding: 16vh 4vw 14vh;
    scroll-margin-top: 4vh;
  }

  .tech-title {
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 3.9vw, 52px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .tech-title-2 { color: var(--accent); }
  .tech-intro {
    margin: 26px 0 0;
    max-width: 720px;
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.6;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }

  /* Featured technical projects: an index plate. Typography and rules carry
     the design: stamped chips, letterpress title, newspaper columns,
     crop-mark corners. No background fills anywhere. */
  .featured {
    position: relative;
    margin-top: 7vh;
    padding: 30px 28px 34px;
  }

  .feat-hero {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 4vw;
    text-align: left;
    padding: 0 0 0 26px;
    background: none;
    border: none;
    border-left: 3px solid var(--accent);
    cursor: pointer;
  }
  .fh-body { min-width: 0; max-width: 860px; }
  .fr-chip {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink);
    border: 1px solid rgba(41, 33, 23, 0.45);
    padding: 5px 10px;
    margin-bottom: 16px;
  }
  .fh-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.12;
    color: var(--ink);
    text-shadow: 1.5px 1.5px 0 rgba(46, 74, 58, 0.16);
    transition: color 0.2s;
  }
  .fh-desc {
    display: block;
    margin-top: 12px;
    max-width: 62ch;
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.1vw, 15.5px);
    line-height: 1.6;
    color: var(--ink-muted-2);
    text-wrap: pretty;
  }
  .fr-slip {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink-muted-3);
    white-space: nowrap;
    flex-shrink: 0;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(41, 33, 23, 0.4);
    transition: color 0.2s, border-color 0.2s;
  }
  .feat-hero:hover .fh-title { color: var(--accent); }
  .feat-hero:hover .fr-slip,
  .feat-col:hover .fr-slip {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Coursework: newspaper columns, hairline dividers, open paper */
  .feat-cols {
    margin-top: 5.5vh;
    padding-top: 3.5vh;
    border-top: 1px solid rgba(41, 33, 23, 0.18);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .feat-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    text-align: left;
    padding: 0 28px;
    background: none;
    border: none;
    border-left: 1px solid rgba(41, 33, 23, 0.18);
    cursor: pointer;
  }
  .feat-col:first-child { border-left: none; padding-left: 0; }
  .feat-col .fr-chip { margin-bottom: 14px; color: var(--ink-muted-2); border-color: rgba(41, 33, 23, 0.35); }
  .fc-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.25;
    color: var(--ink);
    transition: color 0.2s;
  }
  .feat-col:hover .fc-title { color: var(--accent); }
  .feat-col .fr-slip { margin-top: 18px; }

  .tk-label {
    margin: 4vh 0 0;
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--grey-label);
  }

  /* The skill stream: layered marquee lanes, edge-faded, pausable */
  .stream-note {
    margin: 3vh 0 0;
    max-width: 820px;
    font-family: var(--font-sans);
    font-size: clamp(13px, 1.05vw, 14.5px);
    line-height: 1.6;
    color: var(--ink-muted-4);
    text-wrap: pretty;
  }
  .stream {
    margin-top: 2vh;
    padding: 3vh 0;
    border-top: 1px solid rgba(41, 33, 23, 0.18);
    border-bottom: 1px solid rgba(41, 33, 23, 0.18);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, #000 14%, #000 86%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14%, #000 86%, transparent 100%);
  }
  .lane { overflow: hidden; }
  .lane + .lane { margin-top: 2.6vh; }
  .lane-inner {
    display: flex;
    align-items: center;
    gap: 56px;
    width: max-content;
    padding-right: 56px;
  }
  /* Each cluster ties a tool to the techniques it pulls with it: tight gap
     inside a cluster, a wider gap (from .lane-inner) between clusters. */
  .sk-cluster {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .sk-major {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(19px, 1.9vw, 27px);
    color: var(--ink);
    white-space: nowrap;
  }
  .sk-chip {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink-muted-3);
    border: 1px solid rgba(41, 33, 23, 0.28);
    padding: 6px 12px;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lane-inner { animation: lane-flow var(--dur) linear infinite; }
    .lane-rev .lane-inner { animation-direction: reverse; }
    .stream:hover .lane-inner { animation-play-state: paused; }
  }
  @keyframes lane-flow {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lane-inner { flex-wrap: wrap; width: 100%; }
    .lane-inner > *:nth-child(n + 12) { display: none; }
  }


  @media (max-width: 900px) {
    .feat-hero { flex-direction: column; align-items: flex-start; gap: 20px; }
    .feat-cols { grid-template-columns: 1fr; gap: 3.5vh 0; }
    .feat-col {
      border-left: none;
      padding: 0 0 3.5vh;
      border-bottom: 1px solid rgba(41, 33, 23, 0.14);
    }
    .feat-col:last-child { border-bottom: none; padding-bottom: 0; }
  }
  @media (max-width: 720px) {
    .tech { padding: 12vh 6vw 10vh; }
    .featured { padding: 24px 16px 28px; }
  }
</style>

<script>
  // Four marquee lanes running `infinite`. An animation does not stop when it
  // scrolls out of view — the compositor keeps ticking the transform on all
  // four lanes for as long as the page is open, including the whole time the
  // reader is somewhere else entirely. On a phone that is a thread that never
  // goes idle, competing with the scroll it is not even visible during.
  //
  // Paused off-screen, resumed on. `animation-play-state` holds the position,
  // so the stream picks up mid-flow rather than snapping back to the start.
  function initStreamGate() {
    const stream = document.querySelector('.stream');
    if (!(stream instanceof HTMLElement) || stream.dataset.gated) return;
    stream.dataset.gated = 'true';
    const io = new IntersectionObserver(
      ([e]) => stream.classList.toggle('is-offscreen', !e.isIntersecting),
      { rootMargin: '100px' }
    );
    io.observe(stream);
  }
  document.addEventListener('astro:page-load', initStreamGate);
</script>

<style>
  .stream.is-offscreen .lane-inner { animation-play-state: paused; }
</style>
