---
import '../styles/global.css';
import portrait from '../assets/portrait.jpg';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

// The atmosphere layer is the portrait blurred 22px at half opacity, stretched
// across the viewport. It never needed full resolution — it was shipping the
// entire 274KB photo a second time on every page just to be smeared.
const atmosphere = await getImage({ src: portrait, width: 64, format: 'webp', quality: 60 });

interface Props {
  title?: string;
  description?: string;
  /** Share card under /og/. Without one, scrapers pick the biggest image on
   *  the page, which made the homepage link a photo of Michael. */
  ogImage?: string;
  /** Case pages pass their breadcrumb label so search results show
   *  rmtdco.com › Work › <case> instead of a bare URL. */
  breadcrumb?: string;
}

const {
  title = 'Michael Doerffler',
  description = 'Michael Doerffler builds decision systems for agencies, sales teams, and portfolios. Business Analytics & AI, USF, Dec 2026.',
  ogImage = '/og/home.png',
  breadcrumb,
} = Astro.props;

// Each page's own address. Previously og:url was hardcoded to the homepage,
// so sharing a case study told LinkedIn and Slack the wrong URL.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// og:image must be absolute. make-preview.mjs rewrites this host so the
// Netlify preview points at images that actually exist there.
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Structured data. Every value here already appears on the site — nothing is
// asserted to Google that a visitor cannot also read.
const isHome = Astro.url.pathname === '/';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Michael Doerffler',
  url: 'https://rmtdco.com',
  jobTitle: 'Business Analytics and AI',
  email: 'mailto:michael@rmtdco.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Tampa', addressRegion: 'FL', addressCountry: 'US' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of South Florida' },
  sameAs: ['https://www.linkedin.com/in/michael-doerffler'],
};
const breadcrumbSchema = breadcrumb && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Case Studies', item: 'https://rmtdco.com/#work' },
    { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Michael Doerffler" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#E9E1CF" />
    <!-- The timeline's line: solid to now, dashed after. Bare on transparency
         in the tab; the SVG is listed first because browsers prefer it and it
         is the only one that can switch colour for dark chrome. The phone icon
         carries a field because iOS composites transparency onto black. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Loaded without blocking first paint: the stylesheet is fetched as
         print media, then promoted to all once it arrives. display=swap in the
         URL means text renders in the fallback serif meanwhile rather than
         staying invisible. <noscript> covers the rare case of JS being off. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Figtree:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Figtree:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter />
  </head>
  <body>
    <!-- Full-viewport atmosphere: the portrait's own colors, blurred wide,
         under a cream veil — one color world across the whole screen -->
    <div class="photo-atmosphere" aria-hidden="true" style={`background-image: url(${atmosphere.src});`}></div>
    <div class="page-wash" aria-hidden="true"></div>

    <!-- Base paper tooth — always on (canonical turbulence data-URI) -->
    <div class="paper-tooth" aria-hidden="true"></div>

    <main class="page-content">
      <slot />
      <Footer />
    </main>

    <!-- Fine film grain — over everything, type included (canonical data-URI) -->
    <div class="film-grain" aria-hidden="true"></div>

    <!-- Reveal-on-scroll: toggles on every viewport entry/exit, so it replays.
         astro:page-load fires on first load and after every client-side swap. -->
    <script>
      function initReveals() {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) e.target.classList.toggle('is-visible', e.isIntersecting);
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveals);
    </script>
  </body>
</html>

<style>
  /* Rendered at quarter size and scaled up: same soft atmosphere,
     a fraction of the GPU cost of blurring the full viewport */
  .photo-atmosphere {
    position: fixed;
    top: 0;
    left: 0;
    width: 25%;
    height: 25%;
    z-index: 0;
    pointer-events: none;
    background-size: cover;
    background-position: 50% 42%;
    /* Lifted hard: the photo's night sky and cloud must read as soft tone,
       not a dark smudge floating over text at wide aspect ratios */
    filter: blur(22px) saturate(1.1) brightness(1.8);
    transform: scale(4.4);
    transform-origin: 0 0;
    opacity: 0.5;
  }

  /* Cream veil + refined depth over the atmosphere: keeps the page light and
     readable while the photo's dusk tones glow through. The dark ocean/night
     sky from the portrait is pulled out as its own gradient and dispersed
     from the photo's corner across the page, so the deep teal-black unifies
     with the cream rather than stopping at the portrait's edge. */
  .page-wash {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(70% 55% at 50% 0%, rgba(238, 231, 214, 0.5), transparent 72%),
      radial-gradient(64% 56% at 72% 50%, rgba(201, 122, 62, 0.16), transparent 88%),
      radial-gradient(85% 76% at 84% 44%, rgba(13, 20, 20, 0.24), transparent 92%),
      radial-gradient(58% 52% at 14% 74%, rgba(46, 74, 58, 0.12), transparent 88%),
      linear-gradient(180deg, rgba(233, 225, 207, 0.62), rgba(233, 225, 207, 0.44) 46%, rgba(233, 225, 207, 0.58)),
      radial-gradient(135% 135% at 50% 42%, transparent 60%, rgba(41, 33, 23, 0.08) 100%);
  }

  .paper-tooth {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.34;
    background-image: url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22900%22%20height=%22900%22%3E%3Cfilter%20id=%22m%22%3E%3CfeTurbulence%20type=%22fractalNoise%22%20baseFrequency=%220.006%22%20numOctaves=%223%22%20stitchTiles=%22stitch%22%20seed=%2211%22/%3E%3CfeColorMatrix%20type=%22matrix%22%20values=%220%200%200%200%200.26%200%200%200%200%200.21%200%200%200%200%200.13%200%200%200%200.4%200%22/%3E%3C/filter%3E%3Crect%20width=%22900%22%20height=%22900%22%20filter=%22url(%23m)%22/%3E%3C/svg%3E');
    background-size: 1400px 1400px;
  }

  .page-content {
    position: relative;
    z-index: 1;
  }

  .film-grain {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: var(--grain-o);
    background-image: url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22300%22%20height=%22300%22%3E%3Cfilter%20id=%22g%22%3E%3CfeTurbulence%20type=%22fractalNoise%22%20baseFrequency=%220.72%22%20numOctaves=%222%22%20stitchTiles=%22stitch%22%20seed=%227%22/%3E%3CfeColorMatrix%20type=%22matrix%22%20values=%220%200%200%200%200.16%200%200%200%200%200.13%200%200%200%200%200.09%200%200%200%200.62%200%22/%3E%3C/filter%3E%3Crect%20width=%22300%22%20height=%22300%22%20filter=%22url(%23g)%22/%3E%3C/svg%3E');
    background-size: 300px 300px;
  }
</style>
