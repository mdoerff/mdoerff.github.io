---
import '../styles/global.css';
import portrait from '../assets/portrait.jpg';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { NAME, BIO_SHORT, PERSON_ID, SITE_ID, SITE_URL, personNode, personRef } from '../data/site';
import { dateFor } from '../data/page-dates.mjs';

// The atmosphere layer is the portrait blurred 22px at half opacity, stretched
// across the viewport. It never needed full resolution — it was shipping the
// entire 274KB photo a second time on every page just to be smeared.
const atmosphere = await getImage({ src: portrait, width: 64, format: 'webp', quality: 60 });
// The same photo at a size worth calling a portrait, for Person.image. Google
// wants a real picture of the person here, not the share card.
const personPhoto = await getImage({ src: portrait, width: 900, format: 'jpeg', quality: 78 });

/** An organization named on a page, for a case study's `about`. */
interface SchemaOrg {
  name: string;
  url?: string;
}

/** The project a case-study or technical page documents. Everything here has
 *  to be readable on the page itself. */
interface WorkNode {
  name: string;
  description: string;
  /** Organizations the work was done for or inside. */
  about?: SchemaOrg[];
  /** When the work happened. Not datePublished: these pages document projects,
   *  and the period is the honest date, not a publication timestamp. */
  temporalCoverage?: string;
  /** Tools and domains, matching what the page's own copy names. */
  keywords?: string[];
}

interface Props {
  title?: string;
  description?: string;
  /** Share card under /og/. Without one, scrapers pick the biggest image on
   *  the page, which made the homepage link a photo of Michael. */
  ogImage?: string;
  /** Case pages pass their breadcrumb label so search results show
   *  rmtdco.com › Work › <case> instead of a bare URL. */
  breadcrumb?: string;
  /** Where the breadcrumb's first rung points. Technical pages hang off
   *  /#technical, case studies off /#work. */
  breadcrumbRoot?: 'work' | 'technical';
  /** og:type. The homepage is a profile, project pages are articles about a
   *  piece of work, everything else is a plain page. */
  ogType?: 'website' | 'profile' | 'article';
  /** Only the 404 sets this. Nothing public is ever withheld from a crawler. */
  noindex?: boolean;
  /** Emits ProfilePage instead of WebPage and inlines the full Person node. */
  isProfile?: boolean;
  /** The project this page documents, emitted as the page's mainEntity. */
  work?: WorkNode;
}

const {
  title = NAME,
  description = BIO_SHORT,
  ogImage = '/og/home.png',
  breadcrumb,
  breadcrumbRoot = 'work',
  ogType = 'website',
  noindex = false,
  isProfile = false,
  work,
} = Astro.props;

// Each page's own address. Previously og:url was hardcoded to the homepage,
// so sharing a case study told LinkedIn and Slack the wrong URL.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// og:image must be absolute. make-preview.mjs rewrites this host so the
// Netlify preview points at images that actually exist there.
const ogImageUrl = new URL(ogImage, Astro.site).href;
const personImageUrl = new URL(personPhoto.src, Astro.site).href;

// Search-engine verification. Both consoles accept a file upload instead, but
// a meta tag survives a rebuild and a DNS move. Empty means nothing is emitted.
//
// Google's tag is load-bearing beyond Google: Search Console was first
// verified through the Google Analytics tag, and Bing was verified by
// importing from Search Console rather than with a token of its own. So this
// one meta tag is the anchor for both consoles once the GA tag goes, and
// Bing has no independent anchor until a DNS record gives it one.
const GOOGLE_SITE_VERIFICATION = '3MgZn9RcPC1o3hqxIgRjRdTncp_6k7vIliQECD3hRsQ';
const BING_SITE_VERIFICATION = '';

// Plausible. The account is keyed on the domain, which already lives once in
// site.ts, so it is derived rather than retyped: if the site ever moves, the
// tag and the runtime guard below move with it. The script URL is the
// site-keyed tracker from the Plausible dashboard; the key identifies the
// site, so there is no data-domain attribute to keep in step.
const PLAUSIBLE_DOMAIN = new URL(SITE_URL).host;
const PLAUSIBLE_SRC = 'https://plausible.io/js/pa-s_fRFBu_daUcEZGVVZpgL.js';

// Machine-readable twin of this page, emitted by scripts/make-machine-mirrors.mjs
// after the build. Advertised so an agent can fetch clean markdown instead of
// parsing styled HTML. Only the case and technical pages have one.
const mirrorPath =
  Astro.url.pathname === '/'
    ? '/index.md'
    : /^\/(work|technical)\/.+/.test(Astro.url.pathname)
      ? Astro.url.pathname.replace(/\/$/, '') + '.md'
      : null;
const mirrorUrl = mirrorPath ? new URL(mirrorPath, Astro.site).href : null;

// ---- Structured data ------------------------------------------------------
// One @graph per page rather than several loose blocks, so the nodes can point
// at each other by @id. Every value restates something on the page.
const pageModified = dateFor(Astro.url.pathname);
const pageId = `${canonical}#page`;
const workId = `${canonical}#work`;
const crumbId = `${canonical}#breadcrumb`;

const nodes: Record<string, unknown>[] = [];

nodes.push(isProfile ? personNode(personImageUrl) : personRef);

nodes.push({
  '@type': 'WebSite',
  '@id': SITE_ID,
  url: `${SITE_URL}/`,
  name: NAME,
  description: BIO_SHORT,
  inLanguage: 'en-US',
  publisher: { '@id': PERSON_ID },
});

const breadcrumbSchema = breadcrumb && {
  '@type': 'BreadcrumbList',
  '@id': crumbId,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: breadcrumbRoot === 'technical' ? 'Technical Projects' : 'Case Studies',
      item: `${SITE_URL}/#${breadcrumbRoot}`,
    },
    { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical },
  ],
};

const workSchema = work && {
  '@type': 'CreativeWork',
  '@id': workId,
  name: work.name,
  description: work.description,
  url: canonical,
  author: { '@id': PERSON_ID },
  creator: { '@id': PERSON_ID },
  ...(work.about && {
    about: work.about.map((o) => ({ '@type': 'Organization', name: o.name, ...(o.url && { url: o.url }) })),
  }),
  ...(work.temporalCoverage && { temporalCoverage: work.temporalCoverage }),
  ...(work.keywords && { keywords: work.keywords.join(', ') }),
  inLanguage: 'en-US',
  isPartOf: { '@id': SITE_ID },
  ...(pageModified && { dateModified: pageModified }),
};

nodes.push({
  '@type': isProfile ? 'ProfilePage' : 'WebPage',
  '@id': pageId,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': SITE_ID },
  inLanguage: 'en-US',
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
  // From git history, same source as the sitemap's lastmod. Retrieval systems
  // weight recency, and the site emitted no date at all before this.
  ...(pageModified && { dateModified: pageModified }),
  ...(isProfile
    ? { mainEntity: { '@id': PERSON_ID }, about: { '@id': PERSON_ID } }
    : work
      ? { mainEntity: { '@id': workId }, about: { '@id': workId } }
      : {}),
  ...(breadcrumbSchema && { breadcrumb: { '@id': crumbId } }),
});

if (workSchema) nodes.push(workSchema);
if (breadcrumbSchema) nodes.push(breadcrumbSchema);

const graph = { '@context': 'https://schema.org', '@graph': nodes };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={NAME} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="rmtdco.com" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <!-- X/Twitter reads og:* as a fallback, but Slack, Discord and iMessage
         all prefer the card tags when present, and summary_large_image is the
         only way to get the 1200x630 share card rather than a thumbnail. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="canonical" href={canonical} />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    {BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}
    {mirrorUrl && <link rel="alternate" type="text/markdown" href={mirrorUrl} title="Markdown version" />}
    <meta name="theme-color" content="#E9E1CF" />
    <!-- The timeline's line: solid to now, dashed after. Bare on transparency
         in the tab; the SVG is listed first because browsers prefer it and it
         is the only one that can switch colour for dark chrome. The phone icon
         carries a field because iOS composites transparency onto black. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- Fonts are self-hosted from /fonts/ and declared in global.css, so
         there is nothing to preconnect to and no third-party stylesheet to
         load without blocking. These two faces carry first paint (the
         nameplate and all body copy), so they are fetched in parallel with
         the CSS rather than waiting for it to parse. The latin-ext cuts are
         left to load on demand; almost nothing on this site needs them. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/libre-baskerville-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/figtree-latin.woff2" crossorigin />
    <!-- Plausible, in place of Google Analytics 4. GA shipped on the order of
         a hundred kilobytes of JavaScript from two Google origins, set
         two-year cookies, and was ungated, so every editing session and every
         preview counted as a real visit on the real property. This tracker is
         about six kilobytes from one origin and sets no cookies.

         It is gated twice, and the gates are different in kind. The first is
         build time: this block only renders when Astro builds for production,
         so the dev server hands over pages with no analytics in them at all.
         The second is run time: the tracker does nothing until init is
         called, and init is only called when the page is served from the real
         host. That second gate is not redundant, because `astro preview` and
         the Netlify preview both serve a production build, so the first gate
         has already passed by the time they are reached. The tracker also
         refuses loopback hosts on its own and checks the opt-out flag below
         on every event, both read from its source rather than assumed.

         The author's own visits: opening /?analytics=off once in a browser
         sets a localStorage flag the tracker honors from then on, and
         /?analytics=on clears it. Per browser and per device; the console
         line is the only confirmation, nothing is added to the page.

         Feature toggles such as outbound links live in the Plausible site
         settings and take effect without touching this snippet. Exactly two
         custom events are fired here, both decisions rather than reading,
         because a pageview already covers reading: the masthead call to
         action, which jumps within the page and so has never left a trace in
         anything, and the email address, which outbound-link tracking cannot
         see because a mailto anchor has no host to compare. A goal with each
         exact name must exist in Plausible or the events are accepted and
         silently discarded. The click listener hangs off document because
         this runs before the body is parsed. -->
    {import.meta.env.PROD && (
      <Fragment>
        <script
          is:inline
          set:html={`
(function () {
  try {
    var choice = new URLSearchParams(location.search).get('analytics');
    if (choice === 'off') {
      localStorage.setItem('plausible_ignore', 'true');
      console.log('Analytics is now off in this browser. Undo with ?analytics=on');
    } else if (choice === 'on') {
      localStorage.removeItem('plausible_ignore');
      console.log('Analytics is now on in this browser.');
    }
  } catch (e) {}
  window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };
  window.plausible.init = window.plausible.init || function (i) { window.plausible.o = i || {}; };
  if (location.hostname === '${PLAUSIBLE_DOMAIN}') window.plausible.init();
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a') : null;
    if (!a) return;
    var href = a.getAttribute('href') || '';
    if (href.slice(-8) === '#contact') window.plausible('Contact CTA');
    else if (href.indexOf('mailto:') === 0) window.plausible('Email click');
  });
})();`}
        />
        <script is:inline async src={PLAUSIBLE_SRC}></script>
      </Fragment>
    )}
  </head>
  <body>
    <!-- Full-viewport atmosphere: the portrait's own colors, blurred wide,
         under a cream veil — one color world across the whole screen -->
    <div class="photo-atmosphere" aria-hidden="true" style={`background-image: url(${atmosphere.src});`}></div>
    <div class="page-wash" aria-hidden="true"></div>

    <!-- Base paper tooth — always on (canonical turbulence data-URI) -->
    <div class="paper-tooth" aria-hidden="true"></div>

    <!-- The footer sits outside <main> on purpose: a <footer> only becomes the
         page's contentinfo landmark when it is a direct child of <body>, and
         screen-reader users navigate to contact details by that landmark. -->
    <main class="page-content">
      <slot />
    </main>
    <Footer />

    <!-- Fine film grain — over everything, type included (canonical data-URI) -->
    <div class="film-grain" aria-hidden="true"></div>

    <!-- Reveal-on-scroll. On a pointer device this replays: the class toggles
         on every viewport entry AND exit, so a section re-animates each time
         you scroll back to it.

         Touch devices reveal once and then stop being observed. Replaying is
         the wrong behaviour on a phone twice over. It costs the most exactly
         when it can be felt — a flick scroll re-triggers a screenful of
         animations at once — and it reads as a fault rather than an effect,
         because scrolling up to re-read something you just read makes it
         dissolve and resolve again under your thumb. Unobserving also lets
         the observer empty out as you descend, so a long case page gets
         cheaper to scroll the further down you are. -->
    <script>
      function initReveals() {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        const once = window.matchMedia('(hover: none)').matches;
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (once) {
                if (!e.isIntersecting) continue;
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              } else {
                e.target.classList.toggle('is-visible', e.isIntersecting);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
      // Module scripts are deferred, so the document is already parsed by the
      // time this runs; the readyState check is belt and braces.
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initReveals, { once: true });
      else initReveals();
    </script>
  </body>
</html>

<style>
  /* Rendered at quarter size and scaled up: same soft atmosphere,
     a fraction of the GPU cost of blurring the full viewport */
  .photo-atmosphere {
    position: fixed;
    top: 0;
    left: 0;
    width: 25%;
    height: 25%;
    z-index: 0;
    pointer-events: none;
    background-size: cover;
    background-position: 50% 42%;
    /* Lifted hard: the photo's night sky and cloud must read as soft tone,
       not a dark smudge floating over text at wide aspect ratios */
    filter: blur(22px) saturate(1.1) brightness(1.8);
    transform: scale(4.4);
    transform-origin: 0 0;
    opacity: 0.5;
  }

  /* Cream veil + refined depth over the atmosphere: keeps the page light and
     readable while the photo's dusk tones glow through. The dark ocean/night
     sky from the portrait is pulled out as its own gradient and dispersed
     from the photo's corner across the page, so the deep teal-black unifies
     with the cream rather than stopping at the portrait's edge. */
  .page-wash {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(70% 55% at 50% 0%, rgba(238, 231, 214, 0.5), transparent 72%),
      radial-gradient(64% 56% at 72% 50%, rgba(201, 122, 62, 0.16), transparent 88%),
      radial-gradient(85% 76% at 84% 44%, rgba(13, 20, 20, 0.24), transparent 92%),
      radial-gradient(58% 52% at 14% 74%, rgba(46, 74, 58, 0.12), transparent 88%),
      linear-gradient(180deg, rgba(233, 225, 207, 0.62), rgba(233, 225, 207, 0.44) 46%, rgba(233, 225, 207, 0.58)),
      radial-gradient(135% 135% at 50% 42%, transparent 60%, rgba(41, 33, 23, 0.08) 100%);
  }

  .paper-tooth {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.34;
    background-image: url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22900%22%20height=%22900%22%3E%3Cfilter%20id=%22m%22%3E%3CfeTurbulence%20type=%22fractalNoise%22%20baseFrequency=%220.006%22%20numOctaves=%223%22%20stitchTiles=%22stitch%22%20seed=%2211%22/%3E%3CfeColorMatrix%20type=%22matrix%22%20values=%220%200%200%200%200.26%200%200%200%200%200.21%200%200%200%200%200.13%200%200%200%200.4%200%22/%3E%3C/filter%3E%3Crect%20width=%22900%22%20height=%22900%22%20filter=%22url(%23m)%22/%3E%3C/svg%3E');
    background-size: 1400px 1400px;
  }

  .page-content {
    position: relative;
    z-index: 1;
  }

  .film-grain {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: var(--grain-o);
    background-image: url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22300%22%20height=%22300%22%3E%3Cfilter%20id=%22g%22%3E%3CfeTurbulence%20type=%22fractalNoise%22%20baseFrequency=%220.72%22%20numOctaves=%222%22%20stitchTiles=%22stitch%22%20seed=%227%22/%3E%3CfeColorMatrix%20type=%22matrix%22%20values=%220%200%200%200%200.16%200%200%200%200%200.13%200%200%200%200%200.09%200%200%200%200.62%200%22/%3E%3C/filter%3E%3Crect%20width=%22300%22%20height=%22300%22%20filter=%22url(%23g)%22/%3E%3C/svg%3E');
    background-size: 300px 300px;
  }

  /* Both texture layers are fixed, cover the whole viewport, and blend with
     `multiply`. A blended layer cannot be composited on its own: the browser
     must re-rasterize the layer AND everything showing through it for every
     frame in which the backdrop changes — which, for a fixed layer over a
     scrolling page, is every frame of every scroll. The film grain sits at
     z-index 80, above all content, so this pulled the whole page off the
     compositor's fast path. That is the scroll stutter on a phone: not slow
     JavaScript (the scroll handler measures 0.02ms) but a full-screen repaint
     per frame on a GPU with a fraction of a desktop's fill rate.

     Both textures are dark noise over a light cream page, where `multiply`
     and ordinary alpha compositing land within a shade of each other, so
     touch devices keep the grain and lose the blend. Opacities are trimmed
     because straight compositing reads a little heavier. Desktop is
     untouched. */
  @media (hover: none) {
    .paper-tooth { mix-blend-mode: normal; opacity: 0.26; }
    .film-grain { mix-blend-mode: normal; opacity: calc(var(--grain-o) * 0.8); }
  }
</style>
